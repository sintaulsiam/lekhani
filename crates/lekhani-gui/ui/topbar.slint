import { Button, LineEdit, TextEdit, CheckBox, ListView, ScrollView } from "std-widgets.slint";

// Struct for AutoCorrect list display
export struct AcEntry {
    trigger: string,
    replacement: string,
}

// Struct for Bengali Conjunct display
export struct ConjunctEntry {
    conjunct: string,
    breakdown: string,
    phonetic: string,
    examples: string,
}

// Struct for Typing Analytics Heatmap display
export struct HeatmapEntry {
    character: string,
    count: int,
    percentage: string,
}

// -----------------------------------------------------------------------------
// Reusable Custom Modern UI Components (Matching Mockup Aesthetics)
// -----------------------------------------------------------------------------

component VectorIconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <color> icon-color: #a6adc8;
    in property <color> active-color: #89b4fa;
    in property <color> active-bg: #89b4fa25;
    in property <color> active-border: #89b4fa55;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.active ? root.active-border : (ta.has-hover ? #45475a88 : transparent);
    background: root.active ? root.active-bg : (ta.has-hover ? #ffffff14 : transparent);
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        width: 14px;
        height: 14px;
        colorize: root.active ? root.active-color : (ta.has-hover ? #ffffff : root.icon-color);
    }
}

component CloseButton inherits Rectangle {
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.has-hover ? #f38ba828 : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? #f38ba855 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("../../../data/icons/ui/close.svg");
        width: 12px;
        height: 12px;
        colorize: ta.has-hover ? #f38ba8 : #6c7086;
    }
}

component PopoutButton inherits Rectangle {
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.has-hover ? #89b4fa28 : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa55 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("../../../data/icons/ui/popout.svg");
        width: 12px;
        height: 12px;
        colorize: ta.has-hover ? #89b4fa : #6c7086;
    }
}

component SegmentButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <color> active-color: #89b4fa;
    callback clicked;

    height: 24px;
    border-radius: 6px;
    background: root.active ? #2b2e46 : (ta.has-hover ? #1a1c2b : transparent);
    border-width: 1px;
    border-color: root.active ? #454a66 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? #ffffff : (ta.has-hover ? #cdd6f4 : #9399b2);
                font-size: 11.5px;
                font-weight: root.active ? 700 : 500;
            }
        }
    }
}

component BrandLogo inherits Rectangle {
    in property <bool> active: false;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    height: 26px;
    border-radius: 13px;
    background: root.active ? #89b4fa25 : (ta.has-hover ? #24273a88 : transparent);
    border-width: 1px;
    border-color: root.active ? #89b4fa66 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 9px;
            spacing: 6px;
            alignment: center;

            Image {
                source: @image-url("../../../data/icons/ui/logo.svg");
                width: 16px;
                height: 16px;
                horizontal-alignment: center;
            }

            Text {
                text: "Lekhani";
                color: root.active ? #89b4fa : #f8fafc;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

component LayoutSelectorPill inherits Rectangle {
    in property <string> layout-name;
    in property <bool> active: false;
    in property <bool> is-bengali: true;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    height: 26px;
    background: root.active ? #25283d : (ta.has-hover ? #24273a : #181926bb);
    border-radius: 13px;
    border-width: 1px;
    border-color: root.active ? #89b4fa88 : (ta.has-hover ? #585b70 : #33364d);
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 11px;
            padding-right: 9px;
            spacing: 5px;
            alignment: center;

            Text {
                text: root.layout-name;
                color: root.active ? #89b4fa : #cdd6f4;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                padding-top: 2px;
                Image {
                    source: @image-url("../../../data/icons/ui/chevron_down.svg");
                    width: 9px;
                    height: 9px;
                    colorize: root.active ? #89b4fa : (ta.has-hover ? #cdd6f4 : #9399b2);
                    horizontal-alignment: center;
                }
            }
        }
    }
}

component KeyCapButton inherits Rectangle {
    in property <string> key-char;
    in property <color> text-color: #e2e8f0;
    in property <length> key-width: 34px;
    in property <length> key-height: 30px;
    in property <int> flex-stretch: 1;

    min-width: 24px;
    preferred-width: root.key-width;
    min-height: 26px;
    preferred-height: root.key-height;
    horizontal-stretch: root.flex-stretch;
    vertical-stretch: 1;
    border-radius: 6px;
    background: ta.has-hover ? #2a2d42 : #181926;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa88 : #2d3045;
    animate background, border-color { duration: 80ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
    }

    VerticalLayout {
        alignment: center;
        Text {
            text: root.key-char;
            color: root.text-color;
            font-size: 13.5px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ModernButton inherits Rectangle {
    in property <string> text;
    in property <color> btn-color: #89b4fa;
    in property <bool> primary: false;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    height: 30px;
    border-radius: 7px;
    background: root.primary ? (ta.has-hover ? #89b4fa : #729ded) : (ta.has-hover ? #282b40 : #191a28);
    border-width: 1px;
    border-color: root.primary ? #b4befe88 : (ta.has-hover ? #50567a : #2e3148);
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;
            Text {
                text: root.text;
                color: root.primary ? #0f101a : (ta.has-hover ? #ffffff : #cdd6f4);
                font-size: 12px;
                font-weight: root.primary ? 700 : 600;
                vertical-alignment: center;
            }
        }
    }
}

component ModernToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    callback toggled(bool);

    height: 26px;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        alignment: space-between;
        Text {
            text: root.label;
            color: ta.has-hover ? #ffffff : #cdd6f4;
            font-size: 11.5px;
            font-weight: 500;
            vertical-alignment: center;
        }

        Rectangle {
            width: 34px;
            height: 18px;
            border-radius: 9px;
            background: root.checked ? #89b4fa : #2a2d42;
            animate background { duration: 120ms; }

            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: #ffffff;
                x: root.checked ? parent.width - self.width - 2px : 2px;
                y: 2px;
                animate x { duration: 120ms; }
            }
        }
    }
}

component CopyButton inherits Rectangle {
    callback clicked;
    in property <bool> copied: false;
    out property <bool> has-hover: ta.has-hover;

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? #89b4fa22 : #181926aa;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa66 : #2d3045;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        Image {
            source: @image-url("../../../data/icons/ui/copy.svg");
            width: 13px;
            height: 13px;
            colorize: root.copied ? #a6e3a1 : (ta.has-hover ? #89b4fa : #a6adc8);
            horizontal-alignment: center;
        }
    }
}

// -----------------------------------------------------------------------------
// Main Application Window
// -----------------------------------------------------------------------------

export component TopBarWindow inherits Window {
    title: "Lekhani (লেখনী)";
    always-on-top: true;
    no-frame: true;
    background: transparent;
    default-font-family: "Noto Sans, Noto Sans Bengali, Inter, Roboto, sans-serif";
    
    in-out property <string> active-layout-name: "Avro Phonetic";
    in-out property <[string]> available-layouts: ["Avro Phonetic", "Probhat", "National (Jatiya)", "Unijoy", "Munir Optima", "Borno", "Avro Easy"];
    in-out property <bool> is-bengali-mode: true;
    
    // Converter direction and copy state
    in-out property <int> conv-direction: 0; // 0: Bijoy -> Unicode, 1: Unicode -> Bijoy
    in-out property <bool> conv-copied: false;
    callback copy-to-clipboard(string);
    
    // Dialog state: 0: None, 1: Layout Menu, 2: Layout Viewer, 3: AutoCorrect, 4: Converter, 5: Settings, 6: About, 7: Conjuncts, 8: Stats
    in-out property <int> active-dialog: 0;

    // Helper getters/setters for Rust backend compatibility
    in-out property <bool> show-layout-menu: root.active-dialog == 1;
    in-out property <bool> show-viewer-dialog: root.active-dialog == 2;
    in-out property <bool> show-autocorrect-dialog: root.active-dialog == 3;
    in-out property <bool> show-converter-dialog: root.active-dialog == 4;
    in-out property <bool> show-settings-dialog: root.active-dialog == 5;
    in-out property <bool> show-about-dialog: root.active-dialog == 6;
    in-out property <bool> show-conjunct-dialog: root.active-dialog == 7;
    in-out property <bool> show-stats-dialog: root.active-dialog == 8;

    // Layout Viewer state
    in-out property <int> viewer-mode: 0; // 0: Normal, 1: Shift, 2: AltGr
    in property <[string]> viewer-row-1: [];
    in property <[string]> viewer-row-2: [];
    in property <[string]> viewer-row-3: [];
    in property <[string]> viewer-row-4: [];
    in-out property <string> viewer-selected-layout: root.active-layout-name;
    callback viewer-mode-changed(int);
    callback select-viewer-layout(string);

    // AutoCorrect Manager properties
    in-out property <string> ac-search-query: "";
    in-out property <string> ac-replace-input: "";
    in-out property <string> ac-with-input: "";
    in-out property <string> ac-preview-replace: "";
    in-out property <string> ac-preview-with: "";
    in-out property <string> ac-status-text: "Total entries: 0";

    // Bijoy Converter properties
    in-out property <string> conv-input-text: "";
    in-out property <string> conv-output-text: "";

    // Conjunct Assistant properties
    in-out property <string> conjunct-search-query: "";
    in-out property <[ConjunctEntry]> conjunct-list: [];

    // Stats Dashboard properties
    in-out property <int> stats-total-words: 0;
    in-out property <int> stats-keystrokes-saved: 0;
    in-out property <string> stats-efficiency-ratio: "0%";
    in-out property <[HeatmapEntry]> stats-top-chars: [];

    // Settings properties
    in-out property <bool> set-use-dict: true;
    in-out property <bool> set-include-eng: true;
    in-out property <bool> set-enter-closes: false;
    in-out property <bool> set-predictive-next: true;
    in-out property <bool> set-code-shield: false;
    in-out property <bool> set-word-segmentation: false;
    in-out property <bool> set-colloquial-dialects: false;
    in-out property <bool> set-banglish-shorthand: true;
    in-out property <bool> set-reduplication: true;
    in-out property <bool> set-phrase-prediction: true;
    in-out property <bool> set-dynamic-macros: false;
    in-out property <bool> set-auto-vowel: true;
    in-out property <bool> set-auto-chandra: true;
    in-out property <bool> set-traditional-kar: false;
    in-out property <bool> set-old-reph: true;
    in-out property <bool> set-numberpad: true;
    in-out property <bool> set-autostart: false;
    in-out property <bool> is-windows: false;
    in-out property <string> set-toggle-key: "F12";
    in-out property <bool> set-show-osd: true;
    in-out property <bool> set-auto-dari: true;
    in-out property <string> settings-status-text: "All changes saved automatically";

    // Mode-Switch OSD HUD properties
    in-out property <bool> show-osd: false;
    in-out property <string> osd-title: "Avro Phonetic";
    in-out property <string> osd-subtitle: "বাংলা মোড সক্রিয় (Bengali Active)";
    in-out property <string> osd-icon: "🇧🇩";
    in-out property <color> osd-badge-color: #a6e3a1;
    in-out property <color> osd-badge-bg: #a6e3a122;

    // Callbacks
    callback select-layout(string);
    callback toggle-layout-mode();
    callback notify-mode-change(bool, string);
    callback trigger-layout-viewer();
    callback trigger-autocorrect();
    callback trigger-converter();
    callback trigger-settings();
    callback trigger-about();
    callback trigger-minimize();
    callback trigger-quit();
    callback start-drag-window();
    callback end-drag-window();
    callback detach-dialog(int);
    
    // AutoCorrect Callbacks
    callback ac-search-changed(string);
    callback ac-add-or-update(string, string);
    callback ac-delete-entry(string);
    callback ac-input-changed(string, string);
    callback ac-save();

    // Converter Callbacks
    callback convert-bijoy-to-unicode(string);
    callback convert-unicode-to-bijoy(string);

    // Conjunct Callbacks
    callback conjunct-search-changed(string);
    callback copy-conjunct(string);

    // Stats Callbacks
    callback refresh-stats();

    // Settings Callbacks
    callback save-settings();
    callback auto-save-settings();
    callback reset-default-settings();

    VerticalLayout {
        alignment: start;
        spacing: 6px;
        padding-top: 6px;
        padding-bottom: 6px;
        padding-left: 6px;
        padding-right: 6px;

        // ---------------------------------------------------------------------
        // Main Floating TopBar (Sleek Compact Dynamic Island Ribbon)
        // ---------------------------------------------------------------------
        Rectangle {
            width: 515px;
            height: 40px;
            background: #11121df6;
            border-radius: 20px;
            border-width: 1.2px;
            border-color: #50567a55;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000aa;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 5px;
                alignment: center;

                // 1. Drag Handle Grip
                Rectangle {
                    width: 14px;
                    height: 26px;
                    border-radius: 4px;
                    background: drag_ta.has-hover ? #31324466 : transparent;
                    animate background { duration: 100ms; }

                    drag_ta := TouchArea {
                        mouse-cursor: move;
                        pointer-event(pe) => {
                            if (pe.kind == PointerEventKind.down) {
                                root.start-drag-window();
                            }
                            if (pe.kind == PointerEventKind.up || pe.kind == PointerEventKind.cancel) {
                                root.end-drag-window();
                            }
                        }
                    }

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../../../data/icons/ui/grip.svg");
                        width: 10px;
                        height: 14px;
                        colorize: drag_ta.has-hover ? #89b4fa : #585b70;
                    }
                }

                // 2. Brand Logo / About Button
                btn_logo := BrandLogo {
                    active: root.active-dialog == 6;
                    clicked => {
                        root.active-dialog = root.active-dialog == 6 ? 0 : 6;
                    }
                }

                // 3. Active Layout Selector Pill Button
                btn_layout := LayoutSelectorPill {
                    layout-name: root.active-layout-name;
                    active: root.active-dialog == 1;
                    is-bengali: root.is-bengali-mode;
                    clicked => {
                        root.active-dialog = root.active-dialog == 1 ? 0 : 1;
                    }
                }

                // 4. Layout Viewer Button (Keyboard Vector Icon)
                btn_viewer := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/keyboard.svg");
                    active: root.active-dialog == 2;
                    active-color: #89b4fa;
                    active-bg: #89b4fa28;
                    active-border: #89b4fa66;
                    clicked => {
                        root.active-dialog = root.active-dialog == 2 ? 0 : 2;
                        if (root.active-dialog == 2) {
                            root.viewer-mode-changed(root.viewer-mode);
                        }
                    }
                }

                // 5. AutoCorrect Manager Button (Pen Vector Icon)
                btn_ac := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/pen.svg");
                    active: root.active-dialog == 3;
                    active-color: #a6e3a1;
                    active-bg: #a6e3a128;
                    active-border: #a6e3a166;
                    clicked => {
                        root.active-dialog = root.active-dialog == 3 ? 0 : 3;
                    }
                }

                // 6. Bijoy ⇄ Unicode Converter Button (Exchange Vector Icon)
                btn_conv := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/exchange.svg");
                    active: root.active-dialog == 4;
                    active-color: #fab387;
                    active-bg: #fab38728;
                    active-border: #fab38766;
                    clicked => {
                        root.active-dialog = root.active-dialog == 4 ? 0 : 4;
                    }
                }

                // 7. Conjunct Assistant Button (Assistant Sparkles Vector Icon)
                btn_conjunct := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/puzzle.svg");
                    active: root.active-dialog == 7;
                    active-color: #89dceb;
                    active-bg: #89dceb28;
                    active-border: #89dceb66;
                    clicked => {
                        root.active-dialog = root.active-dialog == 7 ? 0 : 7;
                    }
                }

                // 8. Personal Typing Telemetry & Speed (3-Bar Equalizer Vector Icon)
                btn_stats := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/chart.svg");
                    active: root.active-dialog == 8;
                    active-color: #f9e2af;
                    active-bg: #f9e2af28;
                    active-border: #f9e2af66;
                    clicked => {
                        root.active-dialog = root.active-dialog == 8 ? 0 : 8;
                        if (root.active-dialog == 8) {
                            root.refresh-stats();
                        }
                    }
                }

                // 9. Settings Button (Gear Vector Icon)
                btn_settings := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/settings.svg");
                    active: root.active-dialog == 5;
                    active-color: #cba6f7;
                    active-bg: #cba6f728;
                    active-border: #cba6f766;
                    clicked => {
                        root.active-dialog = root.active-dialog == 5 ? 0 : 5;
                    }
                }

                // 10. Minimize to System Tray Button (Windows)
                if root.is-windows : btn_minimize := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/minimize.svg");
                    icon-color: #fab387;
                    active: false;
                    active-color: #fab387;
                    active-bg: #fab38728;
                    active-border: #fab38766;
                    clicked => { root.trigger-minimize(); }
                }

                // 11. Exit TopBar Button (Close Vector Icon)
                btn_close := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/close.svg");
                    icon-color: #f38ba8;
                    active: false;
                    active-color: #f38ba8;
                    active-bg: #f38ba828;
                    active-border: #f38ba866;
                    clicked => { root.trigger-quit(); }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 1. Layout Dropdown Popup Panel
        // ---------------------------------------------------------------------
        if (root.active-dialog == 1) : HorizontalLayout {
            padding-left: 95px;
            alignment: start;
            Rectangle {
                width: 220px;
                background: #11121dfa;
                border-radius: 14px;
                border-width: 1.2px;
                border-color: #50567a66;
                drop-shadow-blur: 20px;
                drop-shadow-color: #000000cc;

                VerticalLayout {
                    padding: 8px;
                    spacing: 3px;
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text {
                            text: "KEYBOARD LAYOUTS";
                            color: #89b4fa;
                            font-size: 9.5px;
                            font-weight: 800;
                        }
                        CloseButton {
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                    for layout[idx] in root.available-layouts: Rectangle {
                        height: 30px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: layout == root.active-layout-name ? #89b4fa55 : transparent;
                        background: layout == root.active-layout-name ? #89b4fa20 : (layout_item_ta.has-hover ? #24253a : transparent);
                        animate background { duration: 100ms; }

                        layout_item_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.select-layout(layout);
                                root.active-dialog = 0;
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: space-between;
                            Text {
                                text: layout;
                                color: layout == root.active-layout-name ? #89b4fa : #cdd6f4;
                                font-size: 12px;
                                font-weight: layout == root.active-layout-name ? 700 : 500;
                                vertical-alignment: center;
                            }
                            if (layout == root.active-layout-name) : Text {
                                text: "✓";
                                color: #a6e3a1;
                                font-size: 13px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 2. Visual Keyboard Layout Viewer Dialog (Matching Mockup Card)
        // ---------------------------------------------------------------------
        if (root.active-dialog == 2) : Rectangle {
            width: 480px;
            background: #11121dfa;
            border-radius: 18px;
            border-width: 1.2px;
            border-color: #50567a55;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000cc;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/keyboard.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #89b4fa;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Keyboard Viewer — " + root.active-layout-name;
                            color: #f1f5f9;
                            font-size: 13.5px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        PopoutButton {
                            clicked => {
                                root.active-dialog = 0;
                                root.detach-dialog(2);
                            }
                        }
                        CloseButton {
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                }

                // Mode Segmented Pill Control (Matching Mockup)
                Rectangle {
                    height: 30px;
                    background: #0c0d14;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #242638;
                    HorizontalLayout {
                        padding: 3px;
                        spacing: 4px;
                        SegmentButton {
                            label: "Normal";
                            active: root.viewer-mode == 0;
                            active-color: #89b4fa;
                            clicked => { root.viewer-mode = 0; root.viewer-mode-changed(0); }
                        }
                        SegmentButton {
                            label: "Shift";
                            active: root.viewer-mode == 1;
                            active-color: #a6e3a1;
                            clicked => { root.viewer-mode = 1; root.viewer-mode-changed(1); }
                        }
                        SegmentButton {
                            label: "AltGr";
                            active: root.viewer-mode == 2;
                            active-color: #fab387;
                            clicked => { root.viewer-mode = 2; root.viewer-mode-changed(2); }
                        }
                    }
                }

                // Virtual Keyboard Representation
                Rectangle {
                    background: #0c0d14;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #242638;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        // Row 1: Numbers
                        HorizontalLayout {
                            spacing: 3px;
                            for key in root.viewer-row-1: KeyCapButton {
                                key-char: key;
                                text-color: #89b4fa;
                            }
                        }
                        // Row 2: QWERTY
                        HorizontalLayout {
                            spacing: 3px;
                            for key in root.viewer-row-2: KeyCapButton {
                                key-char: key;
                                text-color: #a6e3a1;
                            }
                        }
                        // Row 3: ASDF
                        HorizontalLayout {
                            spacing: 3px;
                            for key in root.viewer-row-3: KeyCapButton {
                                key-char: key;
                                text-color: #f1f5f9;
                            }
                        }
                        // Row 4: ZXCV
                        HorizontalLayout {
                            spacing: 3px;
                            for key in root.viewer-row-4: KeyCapButton {
                                key-char: key;
                                text-color: #fab387;
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 3. AutoCorrect & Custom Word Dictionary Dialog
        // ---------------------------------------------------------------------
        if (root.active-dialog == 3) : Rectangle {
            width: 480px;
            background: #11121dfa;
            border-radius: 18px;
            border-width: 1.2px;
            border-color: #50567a55;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000cc;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/pen.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #a6e3a1;
                            vertical-alignment: center;
                        }
                        Text { text: "AutoCorrect"; color: #f1f5f9; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        PopoutButton {
                            clicked => {
                                root.active-dialog = 0;
                                root.detach-dialog(3);
                            }
                        }
                        CloseButton {
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                }

                // Search Bar
                search_input := LineEdit {
                    text: root.ac-search-query;
                    placeholder-text: "Search words or triggers...";
                    edited(t) => {
                        root.ac-search-query = t;
                        root.ac-search-changed(t);
                    }
                }

                // Add New Entry Form
                Rectangle {
                    background: #0c0d14;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #242638;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "ADD WORD"; color: #89b4fa; font-size: 9.5px; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 6px;
                            in_replace := LineEdit {
                                text: root.ac-replace-input;
                                placeholder-text: "Trigger (e.g. kothaa)";
                                edited(t) => {
                                    root.ac-replace-input = t;
                                    root.ac-input-changed(t, in_with.text);
                                }
                            }
                            in_with := LineEdit {
                                text: root.ac-with-input;
                                placeholder-text: "Bengali (e.g. কথা)";
                                edited(t) => {
                                    root.ac-with-input = t;
                                    root.ac-input-changed(in_replace.text, t);
                                }
                            }
                            ModernButton {
                                text: "+ Add";
                                primary: true;
                                clicked => {
                                    root.ac-add-or-update(in_replace.text, in_with.text);
                                    root.ac-replace-input = "";
                                    root.ac-with-input = "";
                                }
                            }
                        }
                    }
                }

                // Status bar
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: root.ac-status-text; color: #585b70; font-size: 10.5px; }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 4. Bijoy ⇄ Unicode Converter Dialog
        // ---------------------------------------------------------------------
        if (root.active-dialog == 4) : Rectangle {
            width: 480px;
            background: #11121dfa;
            border-radius: 18px;
            border-width: 1.2px;
            border-color: #50567a55;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000cc;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/exchange.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #fab387;
                            vertical-alignment: center;
                        }
                        Text { text: "Bijoy ⇄ Unicode Converter"; color: #f1f5f9; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        PopoutButton {
                            clicked => {
                                root.active-dialog = 0;
                                root.detach-dialog(4);
                            }
                        }
                        CloseButton {
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                }

                // Mode Selector Segment Tabs
                HorizontalLayout {
                    spacing: 8px;
                    SegmentButton {
                        label: "Bijoy ➔ Unicode";
                        active: root.conv-direction == 0;
                        active-color: #fab387;
                        clicked => {
                            root.conv-direction = 0;
                            if (in_conv_edit.text != "") {
                                root.convert-bijoy-to-unicode(in_conv_edit.text);
                            }
                        }
                    }
                    SegmentButton {
                        label: "Unicode ➔ Bijoy";
                        active: root.conv-direction == 1;
                        active-color: #fab387;
                        clicked => {
                            root.conv-direction = 1;
                            if (in_conv_edit.text != "") {
                                root.convert-unicode-to-bijoy(in_conv_edit.text);
                            }
                        }
                    }
                }

                // Input Box Section
                VerticalLayout {
                    spacing: 5px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.conv-direction == 0 ? "Bijoy (ANSI) Input" : "Unicode Bengali Input";
                            color: #89b4fa;
                            font-size: 11px;
                            font-weight: 700;
                        }
                        if (in_conv_edit.text != "") : Text {
                            text: "Instant conversion active";
                            color: #6c7086;
                            font-size: 10px;
                        }
                    }

                    Rectangle {
                        background: #0b0c14;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #2a2d42;

                        VerticalLayout {
                            padding: 6px;
                            in_conv_edit := LineEdit {
                                text: root.conv-input-text;
                                placeholder-text: root.conv-direction == 0 ? "Paste or type Bijoy text (e.g. Avwg evsjvq Mvb MvB)..." : "Paste or type Unicode text (e.g. আমি বাংলায় গান গাই)...";
                                edited(t) => {
                                    root.conv-input-text = t;
                                    root.conv-copied = false;
                                    if (root.conv-direction == 0) {
                                        root.convert-bijoy-to-unicode(t);
                                    } else {
                                        root.convert-unicode-to-bijoy(t);
                                    }
                                }
                            }
                        }
                    }
                }

                // Action Bar
                HorizontalLayout {
                    alignment: space-between;
                    ModernButton {
                        text: "Convert Now ➔";
                        primary: true;
                        clicked => {
                            if (root.conv-direction == 0) {
                                root.convert-bijoy-to-unicode(in_conv_edit.text);
                            } else {
                                root.convert-unicode-to-bijoy(in_conv_edit.text);
                            }
                        }
                    }
                    ModernButton {
                        text: "Clear";
                        primary: false;
                        clicked => {
                            root.conv-input-text = "";
                            root.conv-output-text = "";
                            root.conv-copied = false;
                        }
                    }
                }

                // Output Box Section
                VerticalLayout {
                    spacing: 5px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.conv-direction == 0 ? "Unicode Bengali Output" : "Bijoy Output";
                            color: #a6e3a1;
                            font-size: 11px;
                            font-weight: 700;
                        }
                        if (root.conv-output-text != "") : Rectangle {
                            height: 18px;
                            border-radius: 4px;
                            background: #a6e3a120;
                            border-width: 1px;
                            border-color: #a6e3a144;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: root.conv-copied ? "Copied to Clipboard! ✓" : "Converted ✓";
                                    color: #a6e3a1;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        min-height: 58px;
                        background: #0b0c14;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.conv-output-text != "" ? #89b4fa44 : #2a2d42;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            alignment: space-between;
                            spacing: 8px;

                            Text {
                                text: root.conv-output-text != "" ? root.conv-output-text : "Converted text will appear here...";
                                color: root.conv-output-text != "" ? #f8fafc : #45475a;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            if (root.conv-output-text != "") : CopyButton {
                                copied: root.conv-copied;
                                clicked => {
                                    root.copy-to-clipboard(root.conv-output-text);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 5. Settings Dialog Window
        // ---------------------------------------------------------------------
        if (root.active-dialog == 5) : Rectangle {
            width: 515px;
            background: #11121dfa;
            border-radius: 18px;
            border-width: 1.2px;
            border-color: #50567a55;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000cc;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/settings.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #cba6f7;
                            vertical-alignment: center;
                        }
                        Text { text: "Settings"; color: #f1f5f9; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        PopoutButton {
                            clicked => {
                                root.active-dialog = 0;
                                root.detach-dialog(5);
                            }
                        }
                        CloseButton {
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                }

                // Scrollable Settings Sections
                ScrollView {
                    preferred-height: 420px;
                    min-height: 380px;
                    max-height: 480px;

                    VerticalLayout {
                        spacing: 10px;
                        alignment: start;

                        // Section 1: Phonetic & Basic Typing
                        Rectangle {
                            background: #0c0d14;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #242638;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "PHONETIC & BASIC TYPING"; color: #89b4fa; font-size: 9.5px; font-weight: 700; }
                                ModernToggleSwitch { label: "Enable Dictionary Suggestions"; checked: root.set-use-dict; toggled(v) => { root.set-use-dict = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Include English in Candidate List"; checked: root.set-include-eng; toggled(v) => { root.set-include-eng = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Enter Key Closes Candidate Window"; checked: root.set-enter-closes; toggled(v) => { root.set-enter-closes = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Auto-Expand Double Period (..) to Dāri (।)"; checked: root.set-auto-dari; toggled(v) => { root.set-auto-dari = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Show Mode-Switch HUD Overlay"; checked: root.set-show-osd; toggled(v) => { root.set-show-osd = v; root.auto-save-settings(); } }

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;
                                    Text { text: "Mode Toggle Hotkey:"; color: #cdd6f4; font-size: 11.5px; vertical-alignment: center; }
                                    SegmentButton {
                                        label: "F12";
                                        active: root.set-toggle-key == "F12";
                                        active-color: #89b4fa;
                                        clicked => { root.set-toggle-key = "F12"; root.auto-save-settings(); }
                                    }
                                    SegmentButton {
                                        label: "Ctrl+Space";
                                        active: root.set-toggle-key == "Ctrl+Space";
                                        active-color: #89b4fa;
                                        clicked => { root.set-toggle-key = "Ctrl+Space"; root.auto-save-settings(); }
                                    }
                                    SegmentButton {
                                        label: "Shift+Space";
                                        active: root.set-toggle-key == "Shift+Space";
                                        active-color: #89b4fa;
                                        clicked => { root.set-toggle-key = "Shift+Space"; root.auto-save-settings(); }
                                    }
                                }
                            }
                        }

                        // Section 2: Smart Assistance & Developer Tools
                        Rectangle {
                            background: #0c0d14;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #242638;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "SMART ASSISTANCE & DEVELOPER TOOLS"; color: #cba6f7; font-size: 9.5px; font-weight: 700; }
                                ModernToggleSwitch { label: "Developer Code Shield (CLI flags, camelCase, keywords)"; checked: root.set-code-shield; toggled(v) => { root.set-code-shield = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Concatenated Word Segmentation (kemonaso ➔ কেমন আছো)"; checked: root.set-word-segmentation; toggled(v) => { root.set-word-segmentation = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Colloquial Dialect Normalization (khamu ➔ খাব, korsi ➔ করেছি)"; checked: root.set-colloquial-dialects; toggled(v) => { root.set-colloquial-dialects = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Banglish Chat Contractions (amr ➔ আমার, tmr ➔ তোমার)"; checked: root.set-banglish-shorthand; toggled(v) => { root.set-banglish-shorthand = v; root.auto-save-settings(); } }
                            }
                        }

                        // Section 3: Predictive Intelligence
                        Rectangle {
                            background: #0c0d14;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #242638;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "PREDICTIVE INTELLIGENCE"; color: #f38ba8; font-size: 9.5px; font-weight: 700; }
                                ModernToggleSwitch { label: "AI Next-Word Prediction"; checked: root.set-predictive-next; toggled(v) => { root.set-predictive-next = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Reduplicated Words Prediction (ধীরে ➔ ধীরে, মাঝে ➔ মাঝে)"; checked: root.set-reduplication; toggled(v) => { root.set-reduplication = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Multi-Word Idiom & Phrase Completion (অনেক অনেক ➔ ধন্যবাদ)"; checked: root.set-phrase-prediction; toggled(v) => { root.set-phrase-prediction = v; root.auto-save-settings(); } }
                            }
                        }

                        // Section 4: Productivity Shortcuts
                        Rectangle {
                            background: #0c0d14;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #242638;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "PRODUCTIVITY SHORTCUTS"; color: #fab387; font-size: 9.5px; font-weight: 700; }
                                ModernToggleSwitch { label: "Dynamic Math & Date Macros (!date, !sum(2+2))"; checked: root.set-dynamic-macros; toggled(v) => { root.set-dynamic-macros = v; root.auto-save-settings(); } }
                            }
                        }

                        // Section 5: Fixed Layout Automations
                        Rectangle {
                            background: #0c0d14;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #242638;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "FIXED LAYOUT AUTOMATION"; color: #a6e3a1; font-size: 9.5px; font-weight: 700; }
                                ModernToggleSwitch { label: "Automatic Vowel Forming (অ + া ➔ আ)"; checked: root.set-auto-vowel; toggled(v) => { root.set-auto-vowel = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Automatic Chandra Position (কঁ + া ➔ কাঁ)"; checked: root.set-auto-chandra; toggled(v) => { root.set-auto-chandra = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Traditional Kar Joining"; checked: root.set-traditional-kar; toggled(v) => { root.set-traditional-kar = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Smart Reph (র্) Insertion"; checked: root.set-old-reph; toggled(v) => { root.set-old-reph = v; root.auto-save-settings(); } }
                                ModernToggleSwitch { label: "Map Numeric Keypad to Bengali (০-৯)"; checked: root.set-numberpad; toggled(v) => { root.set-numberpad = v; root.auto-save-settings(); } }
                            }
                        }

                        // Section 6: System & Startup (Windows)
                        if root.is-windows : Rectangle {
                            background: #0c0d14;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #242638;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "SYSTEM"; color: #f9e2af; font-size: 9.5px; font-weight: 700; }
                                ModernToggleSwitch { label: "Launch on system startup"; checked: root.set-autostart; toggled(v) => { root.set-autostart = v; root.auto-save-settings(); } }
                            }
                        }
                    }
                }

                // Popover Footer: Auto-save status feedback + Action buttons
                HorizontalLayout {
                    alignment: space-between;
                    padding-top: 4px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #a6e3a1;
                        }
                        Text {
                            text: root.settings-status-text;
                            color: #a6adc8;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        ModernButton {
                            text: "Restore Defaults";
                            primary: false;
                            clicked => { root.reset-default-settings(); }
                        }

                        ModernButton {
                            text: "Done";
                            primary: true;
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 6. About Dialog Window
        // ---------------------------------------------------------------------
        if (root.active-dialog == 6) : Rectangle {
            width: 480px;
            background: #11121dfa;
            border-radius: 18px;
            border-width: 1.2px;
            border-color: #50567a55;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000cc;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 52px;
                    height: 52px;
                    background: #0c0d14;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #89b4fa55;
                    drop-shadow-blur: 14px;
                    drop-shadow-color: #89b4fa33;
                    
                    Image {
                        source: @image-url("../../../data/icons/128.png");
                        width: 40px;
                        height: 40px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text { text: "Lekhani (লেখনী)"; color: #f1f5f9; font-size: 17px; font-weight: 800; horizontal-alignment: center; }
                Text { text: "Version 1.0.0 • Pure Rust Architecture"; color: #89b4fa; font-size: 12px; font-weight: 600; horizontal-alignment: center; }
                Text { text: "Author: Sintaul Mahdi Siam • Syntenieum (2026)"; color: #a6e3a1; font-size: 11px; font-weight: 600; horizontal-alignment: center; }
                Text { text: "© 2026 Syntenieum. All rights reserved."; color: #89dceb; font-size: 10.5px; font-weight: 500; horizontal-alignment: center; }
                Text {
                    text: "Modern, Ultra-Fast Bengali Input Method Framework & Desktop Suite for Linux & Windows";
                    color: #a6adc8;
                    font-size: 11.5px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 1px;
                    background: #242638;
                }

                Text {
                    text: "Special thanks to Avro Project (OmicronLab) & OpenBangla Keyboard for their pioneering foundations in Bengali computing.";
                    color: #f9e2af;
                    font-size: 10px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Button {
                    text: "Close";
                    clicked => { root.active-dialog = 0; }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 7. Bengali Conjunct Assistant ("যুক্তবর্ণ সহায়িকা")
        // ---------------------------------------------------------------------
        if (root.active-dialog == 7) : Rectangle {
            width: 480px;
            background: #11121dfa;
            border-radius: 18px;
            border-width: 1.2px;
            border-color: #50567a55;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000cc;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/puzzle.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #89dceb;
                            vertical-alignment: center;
                        }
                        Text { text: "যুক্তবর্ণ সহায়িকা"; color: #f1f5f9; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        PopoutButton {
                            clicked => {
                                root.active-dialog = 0;
                                root.detach-dialog(7);
                            }
                        }
                        CloseButton {
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                }

                // Search Bar
                LineEdit {
                    text: root.conjunct-search-query;
                    placeholder-text: "Search conjunct, breakdown, or phonetic keys (e.g. ক্ষ, kkh, হ + ্ + ম)...";
                    edited(t) => {
                        root.conjunct-search-query = t;
                        root.conjunct-search-changed(t);
                    }
                }

                // Scrollable Conjunct Grid/List
                Rectangle {
                    height: 220px;
                    background: #0c0d14;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #242638;
                    clip: true;

                    ListView {
                        for item[idx] in root.conjunct-list : Rectangle {
                            height: 48px;
                            background: Math.mod(idx, 2) == 0 ? #14152288 : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: space-between;

                                // Conjunct glyph & breakdown
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 7px;
                                        background: #89b4fa20;
                                        border-width: 1px;
                                        border-color: #89b4fa44;
                                        Text {
                                            text: item.conjunct;
                                            color: #89b4fa;
                                            font-size: 17px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Text {
                                            text: item.breakdown;
                                            color: #cdd6f4;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: item.examples;
                                            color: #a6adc8;
                                            font-size: 10px;
                                        }
                                    }
                                }

                                // Phonetic key badge & copy button
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;
                                    Rectangle {
                                        border-radius: 5px;
                                        background: #a6e3a120;
                                        border-width: 1px;
                                        border-color: #a6e3a144;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;
                                            Text {
                                                text: item.phonetic;
                                                color: #a6e3a1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    CopyButton {
                                        clicked => {
                                            root.copy-conjunct(item.conjunct);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 8. Personal Typing Analytics & Speed Heatmap Dashboard
        // ---------------------------------------------------------------------
        if (root.active-dialog == 8) : Rectangle {
            width: 480px;
            background: #11121dfa;
            border-radius: 18px;
            border-width: 1.2px;
            border-color: #50567a55;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000cc;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/chart.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #f9e2af;
                            vertical-alignment: center;
                        }
                        Text { text: "Typing Analytics"; color: #f1f5f9; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background: ta_ref.has-hover ? #31324488 : transparent;
                            border-width: 1px;
                            border-color: ta_ref.has-hover ? #45475a : transparent;
                            ta_ref := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.refresh-stats(); }
                            }
                            Image {
                                source: @image-url("../../../data/icons/ui/refresh.svg");
                                width: 12px;
                                height: 12px;
                                colorize: ta_ref.has-hover ? #f9e2af : #a6adc8;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        PopoutButton {
                            clicked => {
                                root.active-dialog = 0;
                                root.detach-dialog(8);
                            }
                        }
                        CloseButton {
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                }

                // Summary Metric Cards
                HorizontalLayout {
                    spacing: 8px;

                    // Card 1: Words Typed
                    Rectangle {
                        background: #0c0d14;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #89b4fa44;
                        height: 60px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding: 6px;
                            Text { text: "WORDS"; color: #89b4fa; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: root.stats-total-words; color: #f1f5f9; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        }
                    }

                    // Card 2: Keystrokes Saved
                    Rectangle {
                        background: #0c0d14;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #a6e3a144;
                        height: 60px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding: 6px;
                            Text { text: "SAVED KEYS"; color: #a6e3a1; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: root.stats-keystrokes-saved; color: #f1f5f9; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        }
                    }

                    // Card 3: Efficiency Gain
                    Rectangle {
                        background: #0c0d14;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #fab38744;
                        height: 60px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding: 6px;
                            Text { text: "EFFICIENCY"; color: #fab387; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: root.stats-efficiency-ratio; color: #f1f5f9; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        }
                    }
                }

                // Character Frequency Table
                Rectangle {
                    height: 140px;
                    background: #0c0d14;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #242638;
                    clip: true;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: "FREQUENT CHARACTERS"; color: #f9e2af; font-size: 9.5px; font-weight: 700; }
                        ListView {
                            for char_entry in root.stats-top-chars : HorizontalLayout {
                                padding-top: 2px;
                                padding-bottom: 2px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: char_entry.character; color: #89b4fa; font-size: 13px; font-weight: 700; width: 28px; }
                                    Text { text: char_entry.count + "x"; color: #a6adc8; font-size: 11px; }
                                }
                                Text { text: char_entry.percentage; color: #a6e3a1; font-size: 11px; font-weight: 600; }
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 9. Mode-Switch OSD HUD Overlay (Activated on F12 / Layout Toggle)
        // ---------------------------------------------------------------------
        if (root.show-osd) : HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 320px;
                height: 48px;
                background: #11121df4;
                border-radius: 14px;
                border-width: 1.5px;
                border-color: root.osd-badge-color;
                drop-shadow-blur: 20px;
                drop-shadow-color: #000000dd;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    alignment: center;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: root.osd-badge-bg;
                        border-width: 1px;
                        border-color: root.osd-badge-color;

                        Text {
                            text: root.osd-icon;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.osd-title;
                            font-size: 12px;
                            font-weight: 800;
                            color: #cdd6f4;
                        }
                        Text {
                            text: root.osd-subtitle;
                            font-size: 10.5px;
                            font-weight: 600;
                            color: root.osd-badge-color;
                        }
                    }

                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: #313244;
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: 5px;
                        background: #24253a;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            alignment: center;
                            Text {
                                text: "F12";
                                font-size: 10px;
                                font-weight: 700;
                                color: #89b4fa;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Standalone Resizable Desktop Dialog Window
// -----------------------------------------------------------------------------

export component StandaloneDialogWindow inherits Window {
    title: root.dialog-title;
    icon: @image-url("../../../data/icons/128.png");
    min-width: 560px;
    min-height: 440px;
    preferred-width: 720px;
    preferred-height: 520px;
    background: #11121dfa;

    in-out property <int> dialog-type: 4; // 2=Viewer, 3=AutoCorrect, 4=Converter, 5=Settings, 7=Conjuncts, 8=Stats
    in property <string> active-layout-name: "Avro Phonetic";

    // AutoCorrect State
    in property <[AcEntry]> ac-entries: [];
    in-out property <string> ac-search-query: "";
    in-out property <string> ac-replace-input: "";
    in-out property <string> ac-with-input: "";
    in property <string> ac-status-text: "";

    // Converter State
    in-out property <string> conv-input-text: "";
    in-out property <string> conv-output-text: "";
    in-out property <int> conv-direction: 0;
    in-out property <bool> conv-copied: false;

    // Conjunct State
    in property <[ConjunctEntry]> conjunct-list: [];
    in-out property <string> conjunct-search-query: "";

    // Stats State
    in property <int> stats-total-words: 0;
    in property <int> stats-keystrokes-saved: 0;
    in property <[HeatmapEntry]> stats-top-characters: [];

    // Settings State
    in-out property <bool> set-use-dict: true;
    in-out property <bool> set-include-eng: true;
    in-out property <bool> set-enter-closes: false;
    in-out property <bool> set-predictive-next: true;
    in-out property <bool> set-code-shield: false;
    in-out property <bool> set-word-segmentation: false;
    in-out property <bool> set-colloquial-dialects: false;
    in-out property <bool> set-banglish-shorthand: true;
    in-out property <bool> set-reduplication: true;
    in-out property <bool> set-phrase-prediction: true;
    in-out property <bool> set-dynamic-macros: true;
    in-out property <bool> set-auto-vowel: true;
    in-out property <bool> set-auto-chandra: true;
    in-out property <bool> set-traditional-kar: false;
    in-out property <bool> set-old-reph: true;
    in-out property <bool> set-numberpad: true;
    in-out property <string> set-toggle-key: "F12";
    in-out property <bool> set-show-osd: true;
    in-out property <bool> set-auto-dari: true;
    in-out property <bool> set-autostart: false;
    in-out property <bool> is-windows: false;
    in-out property <string> settings-status-text: "All changes saved automatically";

    // Layout Viewer State
    in-out property <int> viewer-mode: 0;
    in property <[string]> viewer-row-1: [];
    in property <[string]> viewer-row-2: [];
    in property <[string]> viewer-row-3: [];
    in property <[string]> viewer-row-4: [];
    in-out property <string> viewer-selected-layout: root.active-layout-name;
    in property <[string]> available-layouts: [];

    property <string> dialog-title: root.dialog-type == 2 ? "Lekhani - Keyboard Layout Viewer (" + root.viewer-selected-layout + ")" :
                                   root.dialog-type == 3 ? "Lekhani - AutoCorrect Manager" :
                                   root.dialog-type == 4 ? "Lekhani - Bijoy ⇄ Unicode Converter" :
                                   root.dialog-type == 5 ? "Lekhani - Settings" :
                                   root.dialog-type == 7 ? "Lekhani - যুক্তবর্ণ সহায়িকা (Conjunct Assistant)" :
                                   root.dialog-type == 8 ? "Lekhani - Typing Telemetry & Speed" : "Lekhani Desktop Suite";

    // Callbacks
    callback close-window();
    callback convert-bijoy-to-unicode(string);
    callback convert-unicode-to-bijoy(string);
    callback copy-to-clipboard(string);
    callback ac-search-changed(string);
    callback ac-add-or-update(string, string);
    callback ac-delete-entry(string);
    callback ac-save();
    callback conjunct-search-changed(string);
    callback copy-conjunct(string);
    callback refresh-stats();
    callback save-settings();
    callback auto-save-settings();
    callback reset-default-settings();
    callback viewer-mode-changed(int);
    callback select-viewer-layout(string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Clean Header Bar
        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Image {
                    source: root.dialog-type == 2 ? @image-url("../../../data/icons/ui/keyboard.svg") :
                            root.dialog-type == 3 ? @image-url("../../../data/icons/ui/pen.svg") :
                            root.dialog-type == 4 ? @image-url("../../../data/icons/ui/exchange.svg") :
                            root.dialog-type == 5 ? @image-url("../../../data/icons/ui/settings.svg") :
                            root.dialog-type == 7 ? @image-url("../../../data/icons/ui/puzzle.svg") :
                            root.dialog-type == 8 ? @image-url("../../../data/icons/ui/chart.svg") :
                            @image-url("../../../data/icons/ui/logo.svg");
                    width: 18px;
                    height: 18px;
                    colorize: root.dialog-type == 2 ? #89b4fa :
                              root.dialog-type == 3 ? #a6e3a1 :
                              root.dialog-type == 4 ? #fab387 :
                              root.dialog-type == 5 ? #cba6f7 :
                              root.dialog-type == 7 ? #89dceb :
                              root.dialog-type == 8 ? #f9e2af : #89b4fa;
                    vertical-alignment: center;
                }
                Text {
                    text: root.dialog-title;
                    color: #f1f5f9;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            CloseButton {
                clicked => { root.close-window(); }
            }
        }

        // ---------------------------------------------------------------------
        // 4. BIJOY ⇄ UNICODE CONVERTER (Standalone Multi-line Resizable)
        // ---------------------------------------------------------------------
        if root.dialog-type == 4: VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            // Mode Selector
            HorizontalLayout {
                spacing: 8px;
                SegmentButton {
                    label: "Bijoy (ANSI) ➔ Unicode Bengali";
                    active: root.conv-direction == 0;
                    active-color: #fab387;
                    clicked => {
                        root.conv-direction = 0;
                        if (root.conv-input-text != "") {
                            root.convert-bijoy-to-unicode(root.conv-input-text);
                        }
                    }
                }
                SegmentButton {
                    label: "Unicode Bengali ➔ Bijoy (ANSI)";
                    active: root.conv-direction == 1;
                    active-color: #fab387;
                    clicked => {
                        root.conv-direction = 1;
                        if (root.conv-input-text != "") {
                            root.convert-unicode-to-bijoy(root.conv-input-text);
                        }
                    }
                }
            }

            // Dual Pane Layout
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                // Left Column: Source
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.conv-direction == 0 ? "Bijoy (ANSI) Source Text:" : "Unicode Bengali Source Text:";
                            color: #89b4fa;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        ModernButton {
                            text: "Clear";
                            clicked => {
                                root.conv-input-text = "";
                                root.conv-output-text = "";
                                root.conv-copied = false;
                            }
                        }
                    }

                    Rectangle {
                        background: #0b0c14;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #2a2d42;
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 8px;
                            vertical-stretch: 1;
                            TextEdit {
                                text <=> root.conv-input-text;
                                vertical-stretch: 1;
                                edited => {
                                    root.conv-copied = false;
                                    if (root.conv-direction == 0) {
                                        root.convert-bijoy-to-unicode(root.conv-input-text);
                                    } else {
                                        root.convert-unicode-to-bijoy(root.conv-input-text);
                                    }
                                }
                            }
                        }
                    }
                }

                // Middle Column: Actions
                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    vertical-stretch: 0;

                    ModernButton {
                        text: "➔ Convert";
                        primary: true;
                        clicked => {
                            if (root.conv-direction == 0) {
                                root.convert-bijoy-to-unicode(root.conv-input-text);
                            } else {
                                root.convert-unicode-to-bijoy(root.conv-input-text);
                            }
                        }
                    }

                    ModernButton {
                        text: "⇄ Swap";
                        clicked => {
                            root.conv-direction = root.conv-direction == 0 ? 1 : 0;
                            let tmp = root.conv-input-text;
                            root.conv-input-text = root.conv-output-text;
                            root.conv-output-text = "";
                            if (root.conv-direction == 0) {
                                root.convert-bijoy-to-unicode(root.conv-input-text);
                            } else {
                                root.convert-unicode-to-bijoy(root.conv-input-text);
                            }
                        }
                    }

                    if (root.conv-output-text != ""): CopyButton {
                        copied: root.conv-copied;
                        clicked => {
                            root.copy-to-clipboard(root.conv-output-text);
                        }
                    }
                }

                // Right Column: Output
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.conv-direction == 0 ? "Unicode Bengali Result:" : "Bijoy (ANSI) Result:";
                            color: #a6e3a1;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if (root.conv-output-text != ""): Text {
                            text: root.conv-copied ? "Copied! ✓" : "Converted ✓";
                            color: #a6e3a1;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        background: #0b0c14;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #2a2d42;
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 8px;
                            vertical-stretch: 1;
                            TextEdit {
                                text: root.conv-output-text;
                                read-only: true;
                                vertical-stretch: 1;
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 3. AUTOCORRECT MANAGER (Standalone Resizable)
        // ---------------------------------------------------------------------
        if root.dialog-type == 3: VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            // Search Bar
            search_input_standalone := LineEdit {
                text: root.ac-search-query;
                placeholder-text: "Search words or triggers...";
                edited(t) => {
                    root.ac-search-query = t;
                    root.ac-search-changed(t);
                }
            }

            // Add Entry Form
            Rectangle {
                background: #0c0d14;
                border-radius: 10px;
                border-width: 1px;
                border-color: #242638;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    Text { text: "ADD OR UPDATE WORD"; color: #89b4fa; font-size: 9.5px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 6px;
                        in_replace_sa := LineEdit {
                            text: root.ac-replace-input;
                            placeholder-text: "Trigger (e.g. kothaa)";
                            edited(t) => { root.ac-replace-input = t; }
                        }
                        Text { text: "➔"; color: #89b4fa; vertical-alignment: center; }
                        in_with_sa := LineEdit {
                            text: root.ac-with-input;
                            placeholder-text: "Bengali (e.g. কথা)";
                            edited(t) => { root.ac-with-input = t; }
                        }
                        ModernButton {
                            text: "Save";
                            primary: true;
                            clicked => {
                                if (in_replace_sa.text != "" && in_with_sa.text != "") {
                                    root.ac-add-or-update(in_replace_sa.text, in_with_sa.text);
                                    in_replace_sa.text = "";
                                    in_with_sa.text = "";
                                }
                            }
                        }
                    }
                }
            }

            // Word List Table
            Rectangle {
                background: #0c0d14;
                border-radius: 10px;
                border-width: 1px;
                border-color: #242638;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 6px;
                    vertical-stretch: 1;
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for entry in root.ac-entries: Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: #13141f;
                                border-width: 1px;
                                border-color: #1e2030;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: center;
                                        Text { text: entry.trigger; color: #89b4fa; font-weight: 600; font-size: 12px; }
                                        Text { text: "➔"; color: #585b70; font-size: 11px; }
                                        Text { text: entry.replacement; color: #f1f5f9; font-weight: 600; font-size: 12px; }
                                    }

                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 5px;
                                        background: del_ta_sa.has-hover ? #f38ba833 : transparent;
                                        del_ta_sa := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.ac-delete-entry(entry.trigger); }
                                        }
                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../../../data/icons/ui/trash.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: del_ta_sa.has-hover ? #f38ba8 : #6c7086;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Status Bar
            Text {
                text: root.ac-status-text;
                color: #6c7086;
                font-size: 10.5px;
                horizontal-alignment: center;
            }
        }

        // ---------------------------------------------------------------------
        // 5. SETTINGS (Standalone Resizable)
        // ---------------------------------------------------------------------
        if root.dialog-type == 5: VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        // Left Column
                        VerticalLayout {
                            spacing: 12px;
                            horizontal-stretch: 1;
                            alignment: start;

                            // Section 1: Phonetic & Basic Typing
                            Rectangle {
                                background: #0c0d14;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #242638;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;
                                    alignment: start;
                                    Text { text: "PHONETIC & BASIC TYPING"; color: #89b4fa; font-size: 10px; font-weight: 700; }
                                    ModernToggleSwitch {
                                        label: "Enable Dictionary Suggestions";
                                        checked <=> root.set-use-dict;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Include English in Candidate List";
                                        checked <=> root.set-include-eng;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Enter Key Closes Candidate Window";
                                        checked <=> root.set-enter-closes;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Auto-Expand Double Period (..) to Dāri (।)";
                                        checked <=> root.set-auto-dari;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Show Mode-Switch HUD Overlay";
                                        checked <=> root.set-show-osd;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        padding-top: 4px;
                                        Text { text: "Mode Toggle Hotkey:"; color: #cdd6f4; font-size: 11.5px; vertical-alignment: center; }
                                        SegmentButton {
                                            label: "F12";
                                            active: root.set-toggle-key == "F12";
                                            active-color: #89b4fa;
                                            clicked => {
                                                root.set-toggle-key = "F12";
                                                root.auto-save-settings();
                                            }
                                        }
                                        SegmentButton {
                                            label: "Ctrl+Space";
                                            active: root.set-toggle-key == "Ctrl+Space";
                                            active-color: #89b4fa;
                                            clicked => {
                                                root.set-toggle-key = "Ctrl+Space";
                                                root.auto-save-settings();
                                            }
                                        }
                                        SegmentButton {
                                            label: "Shift+Space";
                                            active: root.set-toggle-key == "Shift+Space";
                                            active-color: #89b4fa;
                                            clicked => {
                                                root.set-toggle-key = "Shift+Space";
                                                root.auto-save-settings();
                                            }
                                        }
                                    }
                                }
                            }

                            // Section 2: Smart Assistance & Developer Tools
                            Rectangle {
                                background: #0c0d14;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #242638;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;
                                    alignment: start;
                                    Text { text: "SMART ASSISTANCE & DEVELOPER TOOLS"; color: #cba6f7; font-size: 10px; font-weight: 700; }
                                    ModernToggleSwitch {
                                        label: "Developer Code Shield (CLI flags, camelCase, keywords)";
                                        checked <=> root.set-code-shield;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Concatenated Word Segmentation (kemonaso ➔ কেমন আছো)";
                                        checked <=> root.set-word-segmentation;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Colloquial Dialect Normalization (khamu ➔ খাব, korsi ➔ করেছি)";
                                        checked <=> root.set-colloquial-dialects;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Banglish Chat Contractions (amr ➔ আমার, tmr ➔ তোমার)";
                                        checked <=> root.set-banglish-shorthand;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                }
                            }
                        }

                        // Right Column
                        VerticalLayout {
                            spacing: 12px;
                            horizontal-stretch: 1;
                            alignment: start;

                            // Section 3: Predictive Intelligence & Productivity
                            Rectangle {
                                background: #0c0d14;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #242638;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;
                                    alignment: start;
                                    Text { text: "PREDICTIVE INTELLIGENCE & PRODUCTIVITY"; color: #f38ba8; font-size: 10px; font-weight: 700; }
                                    ModernToggleSwitch {
                                        label: "AI Next-Word Prediction";
                                        checked <=> root.set-predictive-next;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Reduplicated Words Prediction (ধীরে ➔ ধীরে, মাঝে ➔ মাঝে)";
                                        checked <=> root.set-reduplication;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Multi-Word Idiom & Phrase Completion (অনেক অনেক ➔ ধন্যবাদ)";
                                        checked <=> root.set-phrase-prediction;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Dynamic Math & Date Macros (!date, !sum(2+2))";
                                        checked <=> root.set-dynamic-macros;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                }
                            }

                            // Section 4: Fixed Layout Options
                            Rectangle {
                                background: #0c0d14;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #242638;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;
                                    alignment: start;
                                    Text { text: "FIXED LAYOUT AUTOMATIONS"; color: #a6e3a1; font-size: 10px; font-weight: 700; }
                                    ModernToggleSwitch {
                                        label: "Automatic Vowel Forming (অ + া ➔ আ)";
                                        checked <=> root.set-auto-vowel;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Automatic Chandra Position (কঁ + া ➔ কাঁ)";
                                        checked <=> root.set-auto-chandra;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Traditional Kar Placement (ী / ূ)";
                                        checked <=> root.set-traditional-kar;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Smart Reph Placement (র্)";
                                        checked <=> root.set-old-reph;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                    ModernToggleSwitch {
                                        label: "Bengali Number Pad Mapping (০-৯)";
                                        checked <=> root.set-numberpad;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                }
                            }

                            // Section 5: System & Startup (Windows)
                            if root.is-windows : Rectangle {
                                background: #0c0d14;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #242638;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;
                                    alignment: start;
                                    Text { text: "SYSTEM"; color: #f9e2af; font-size: 10px; font-weight: 700; }
                                    ModernToggleSwitch {
                                        label: "Launch on system startup";
                                        checked <=> root.set-autostart;
                                        toggled(_) => { root.auto-save-settings(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Settings Footer: Auto-save status feedback + Action buttons
            HorizontalLayout {
                alignment: space-between;
                padding-top: 4px;
                padding-bottom: 2px;

                // Left: Auto-save status feedback
                HorizontalLayout {
                    spacing: 7px;
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: #a6e3a1;
                    }
                    Text {
                        text: root.settings-status-text;
                        color: #a6adc8;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                }

                // Right: Action buttons
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    ModernButton {
                        text: "Restore Defaults";
                        primary: false;
                        clicked => { root.reset-default-settings(); }
                    }

                    ModernButton {
                        text: "Done";
                        primary: true;
                        clicked => { root.close-window(); }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 2. KEYBOARD LAYOUT VIEWER (Standalone Resizable)
        // ---------------------------------------------------------------------
        if root.dialog-type == 2: VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            // Top Control Bar: Layout Selection & Mode Switcher
            HorizontalLayout {
                spacing: 10px;
                alignment: space-between;

                // Layout Selector
                ScrollView {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "LAYOUT:";
                            color: #6c7086;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        for lay in root.available-layouts: Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: root.viewer-selected-layout == lay ? #89b4fa28 : (lay_sa_ta.has-hover ? #25283d : #141522);
                            border-width: 1px;
                            border-color: root.viewer-selected-layout == lay ? #89b4fa : (lay_sa_ta.has-hover ? #454866 : #23253a);
                            lay_sa_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.viewer-selected-layout = lay;
                                    root.select-viewer-layout(lay);
                                }
                            }
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 9px;
                                alignment: center;
                                Text {
                                    text: lay;
                                    color: root.viewer-selected-layout == lay ? #89b4fa : #cdd6f4;
                                    font-size: 11px;
                                    font-weight: root.viewer-selected-layout == lay ? 700 : 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Mode Selector
                Rectangle {
                    height: 30px;
                    background: #0c0d14;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #242638;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 4px;
                        SegmentButton {
                            label: "Normal";
                            active: root.viewer-mode == 0;
                            active-color: #89b4fa;
                            clicked => { root.viewer-mode = 0; root.viewer-mode-changed(0); }
                        }
                        SegmentButton {
                            label: "Shift";
                            active: root.viewer-mode == 1;
                            active-color: #a6e3a1;
                            clicked => { root.viewer-mode = 1; root.viewer-mode-changed(1); }
                        }
                        SegmentButton {
                            label: "AltGr";
                            active: root.viewer-mode == 2;
                            active-color: #fab387;
                            clicked => { root.viewer-mode = 2; root.viewer-mode-changed(2); }
                        }
                    }
                }
            }

            // Keycap Grid
            Rectangle {
                background: #0c0d14;
                border-radius: 12px;
                border-width: 1.2px;
                border-color: #242638;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    vertical-stretch: 1;

                    // Row 1: Numbers / Symbols
                    HorizontalLayout {
                        spacing: 4px;
                        vertical-stretch: 1;
                        for key in root.viewer-row-1: KeyCapButton {
                            key-char: key;
                            text-color: #89b4fa;
                            flex-stretch: 1;
                        }
                    }

                    // Row 2: QWERTY
                    HorizontalLayout {
                        spacing: 4px;
                        vertical-stretch: 1;
                        for key in root.viewer-row-2: KeyCapButton {
                            key-char: key;
                            text-color: #f1f5f9;
                            flex-stretch: 1;
                        }
                    }

                    // Row 3: ASDF
                    HorizontalLayout {
                        spacing: 4px;
                        vertical-stretch: 1;
                        for key in root.viewer-row-3: KeyCapButton {
                            key-char: key;
                            text-color: #a6e3a1;
                            flex-stretch: 1;
                        }
                    }

                    // Row 4: ZXCV
                    HorizontalLayout {
                        spacing: 4px;
                        vertical-stretch: 1;
                        for key in root.viewer-row-4: KeyCapButton {
                            key-char: key;
                            text-color: #fab387;
                            flex-stretch: 1;
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 7. CONJUNCT ASSISTANT (Standalone Resizable)
        // ---------------------------------------------------------------------
        if root.dialog-type == 7: VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            LineEdit {
                text: root.conjunct-search-query;
                placeholder-text: "Search conjunct, breakdown, or phonetic keys (e.g. ক্ষ, kkh, হ + ্ + ম)...";
                edited(t) => {
                    root.conjunct-search-query = t;
                    root.conjunct-search-changed(t);
                }
            }

            Rectangle {
                background: #0c0d14;
                border-radius: 10px;
                border-width: 1px;
                border-color: #242638;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 8px;
                    vertical-stretch: 1;
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for c in root.conjunct-list: Rectangle {
                                height: 38px;
                                border-radius: 6px;
                                background: #13141f;
                                border-width: 1px;
                                border-color: #1e2030;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: center;
                                        Text { text: c.conjunct; color: #89dceb; font-size: 15px; font-weight: 700; }
                                        Text { text: c.breakdown; color: #cdd6f4; font-size: 12px; }
                                        Text { text: "Phonetic: " + c.phonetic; color: #89b4fa; font-size: 11px; }
                                    }

                                    ModernButton {
                                        text: "Copy";
                                        clicked => { root.copy-conjunct(c.conjunct); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 8. TYPING TELEMETRY & STATS (Standalone Resizable)
        // ---------------------------------------------------------------------
        if root.dialog-type == 8: VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    height: 70px;
                    border-radius: 8px;
                    background: #181926bb;
                    border-width: 1px;
                    border-color: #89b4fa44;
                    vertical-stretch: 0;

                    VerticalLayout {
                        alignment: center;
                        Text { text: "Total Words Typed"; color: #89b4fa; font-size: 10.5px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: root.stats-total-words; color: #f1f5f9; font-size: 22px; font-weight: 800; horizontal-alignment: center; }
                    }
                }

                Rectangle {
                    height: 70px;
                    border-radius: 8px;
                    background: #181926bb;
                    border-width: 1px;
                    border-color: #a6e3a144;
                    vertical-stretch: 0;

                    VerticalLayout {
                        alignment: center;
                        Text { text: "Keystrokes Saved"; color: #a6e3a1; font-size: 10.5px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: root.stats-keystrokes-saved; color: #a6e3a1; font-size: 22px; font-weight: 800; horizontal-alignment: center; }
                    }
                }
            }

            Rectangle {
                background: #0c0d14;
                border-radius: 10px;
                border-width: 1px;
                border-color: #242638;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    vertical-stretch: 1;
                    Text { text: "FREQUENTLY TYPED CHARACTERS"; color: #f9e2af; font-size: 10px; font-weight: 700; }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for row in root.stats-top-characters: Rectangle {
                                height: 28px;
                                border-radius: 5px;
                                background: #13141f;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;

                                    Text { text: row.character; color: #f1f5f9; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: row.count + " times (" + row.percentage + ")"; color: #a6adc8; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }

            ModernButton {
                text: "Refresh Stats";
                clicked => { root.refresh-stats(); }
            }
        }
    }
}

import { Button, LineEdit, CheckBox, ListView, ScrollView } from "std-widgets.slint";

// Struct for AutoCorrect list display
export struct AcEntry {
    trigger: string,
    replacement: string,
}

// Struct for Bengali Conjunct display
export struct ConjunctEntry {
    conjunct: string,
    breakdown: string,
    phonetic: string,
    examples: string,
}

// Struct for Typing Analytics Heatmap display
export struct HeatmapEntry {
    character: string,
    count: int,
    percentage: string,
}

// -----------------------------------------------------------------------------
// Reusable Custom Modern UI Components
// -----------------------------------------------------------------------------

component VectorIconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <color> icon-color: #a6adc8;
    in property <color> active-color: #89b4fa;
    in property <color> active-bg: #89b4fa28;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.active ? root.active-color : (ta.has-hover ? #585b7088 : transparent);
    background: root.active ? root.active-bg : (ta.has-hover ? #31324488 : transparent);
    animate background, border-color { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        source: root.icon;
        width: 14px;
        height: 14px;
        colorize: root.active ? root.active-color : (ta.has-hover ? #ffffff : root.icon-color);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component CloseButton inherits Rectangle {
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.has-hover ? #f38ba828 : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? #f38ba855 : transparent;
    animate background, border-color { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        source: @image-url("../../../data/icons/ui/close.svg");
        width: 11px;
        height: 11px;
        colorize: ta.has-hover ? #f38ba8 : #6c7086;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component SegmentButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <color> active-color: #89b4fa;
    callback clicked;

    height: 24px;
    border-radius: 6px;
    background: root.active ? #313244 : (ta.has-hover ? #1e1e2e : transparent);
    border-width: 1px;
    border-color: root.active ? root.active-color : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? #ffffff : (ta.has-hover ? #cdd6f4 : #a6adc8);
            font-size: 11px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }
}

component KeyCapButton inherits Rectangle {
    in property <string> key-char;
    in property <color> text-color: #cdd6f4;

    width: 32px;
    height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? #313244 : #1e1e2e;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa88 : #31324466;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
    }

    Text {
        text: root.key-char;
        color: root.text-color;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// -----------------------------------------------------------------------------
// Main Application Window
// -----------------------------------------------------------------------------

export component TopBarWindow inherits Window {
    title: "Lekhani (লেখনী)";
    always-on-top: true;
    no-frame: true;
    background: transparent;
    default-font-family: "Inter, Noto Sans Bengali, Kalpurush, Ubuntu, sans-serif";
    
    in-out property <string> active-layout-name: "Avro Phonetic";
    in-out property <[string]> available-layouts: ["Avro Phonetic", "Probhat", "National (Jatiya)", "Unijoy", "Munir Optima", "Borno", "Avro Easy"];
    
    // Dialog state: 0: None, 1: Layout Menu, 2: Layout Viewer, 3: AutoCorrect, 4: Converter, 5: Settings, 6: About
    in-out property <int> active-dialog: 0;

    // Helper getters/setters for Rust backend compatibility
    in-out property <bool> show-layout-menu: root.active-dialog == 1;
    in-out property <bool> show-viewer-dialog: root.active-dialog == 2;
    in-out property <bool> show-autocorrect-dialog: root.active-dialog == 3;
    in-out property <bool> show-converter-dialog: root.active-dialog == 4;
    in-out property <bool> show-settings-dialog: root.active-dialog == 5;
    in-out property <bool> show-about-dialog: root.active-dialog == 6;
    in-out property <bool> show-conjunct-dialog: root.active-dialog == 7;
    in-out property <bool> show-stats-dialog: root.active-dialog == 8;

    // Layout Viewer state
    in-out property <int> viewer-mode: 0; // 0: Normal, 1: Shift, 2: AltGr

    // AutoCorrect Manager properties
    in-out property <string> ac-search-query: "";
    in-out property <string> ac-replace-input: "";
    in-out property <string> ac-with-input: "";
    in-out property <string> ac-preview-replace: "";
    in-out property <string> ac-preview-with: "";
    in-out property <string> ac-status-text: "Total entries: 0";

    // Bijoy Converter properties
    in-out property <string> conv-input-text: "";
    in-out property <string> conv-output-text: "";

    // Conjunct Assistant properties
    in-out property <string> conjunct-search-query: "";
    in-out property <[ConjunctEntry]> conjunct-list: [];

    // Stats Dashboard properties
    in-out property <int> stats-total-words: 0;
    in-out property <int> stats-keystrokes-saved: 0;
    in-out property <string> stats-efficiency-ratio: "0%";
    in-out property <[HeatmapEntry]> stats-top-chars: [];

    // Settings properties
    in-out property <bool> set-use-dict: true;
    in-out property <bool> set-include-eng: true;
    in-out property <bool> set-enter-closes: false;
    in-out property <bool> set-predictive-next: true;
    in-out property <bool> set-auto-vowel: true;
    in-out property <bool> set-auto-chandra: true;
    in-out property <bool> set-traditional-kar: false;
    in-out property <bool> set-old-reph: true;
    in-out property <bool> set-numberpad: true;
    in-out property <bool> set-autostart: false;
    in-out property <bool> is-windows: false;
    in-out property <string> set-toggle-key: "F12";
    in-out property <bool> set-show-osd: true;
    in-out property <bool> set-auto-dari: true;

    // Mode-Switch OSD HUD properties
    in-out property <bool> show-osd: false;
    in-out property <string> osd-title: "Avro Phonetic";
    in-out property <string> osd-subtitle: "বাংলা মোড সক্রিয় (Bengali Active)";
    in-out property <string> osd-icon: "🇧🇩";
    in-out property <color> osd-badge-color: #a6e3a1;
    in-out property <color> osd-badge-bg: #a6e3a122;

    // Callbacks
    callback select-layout(string);
    callback toggle-layout-mode();
    callback notify-mode-change(bool, string);
    callback trigger-layout-viewer();
    callback trigger-autocorrect();
    callback trigger-converter();
    callback trigger-settings();
    callback trigger-about();
    callback trigger-quit();
    callback start-drag-window();
    callback end-drag-window();
    
    // AutoCorrect Callbacks
    callback ac-search-changed(string);
    callback ac-add-or-update(string, string);
    callback ac-delete-entry(string);
    callback ac-input-changed(string, string);
    callback ac-save();

    // Converter Callbacks
    callback convert-bijoy-to-unicode(string);
    callback convert-unicode-to-bijoy(string);

    // Conjunct Callbacks
    callback conjunct-search-changed(string);
    callback copy-conjunct(string);

    // Stats Callbacks
    callback refresh-stats();

    // Settings Callbacks
    callback save-settings();

    // Tooltip reactivity based on hover state of buttons
    out property <string> hover-tooltip:
        btn_logo_ta.has-hover ? "About Lekhani (লেখনী)" :
        (btn_layout_ta.has-hover ? "Switch Bengali Keyboard Layout" :
        (btn_viewer.has-hover ? "Keyboard Layout Viewer" :
        (btn_ac.has-hover ? "AutoCorrect & Custom Dictionary" :
        (btn_conv.has-hover ? "Bijoy (ANSI) ⇄ Unicode Converter" :
        (btn_conjunct.has-hover ? "Conjunct Assistant (যুক্তবর্ণ)" :
        (btn_stats.has-hover ? "Typing Telemetry & Speed" :
        (btn_settings.has-hover ? "Settings & Preferences" :
        (drag_ta.has-hover ? "Drag to Move Floating Ribbon" :
        (btn_close.has-hover ? "Exit Lekhani" : "")))))))));

    VerticalLayout {
        alignment: start;
        spacing: 6px;

        // ---------------------------------------------------------------------
        // Main Floating TopBar (Sleek Compact Dynamic Island Ribbon)
        // ---------------------------------------------------------------------
        Rectangle {
            width: 480px;
            height: 40px;
            background: #11111bf4;
            border-radius: 20px;
            border-width: 1px;
            border-color: #313244aa;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: center;

                // 1. Drag Handle Grip
                Rectangle {
                    width: 16px;
                    height: 26px;
                    border-radius: 8px;
                    background: drag_ta.has-hover ? #45475a66 : transparent;
                    animate background { duration: 120ms; }

                    drag_ta := TouchArea {
                        mouse-cursor: move;
                        pointer-event(pe) => {
                            if (pe.kind == PointerEventKind.down) {
                                root.start-drag-window();
                            }
                            if (pe.kind == PointerEventKind.up || pe.kind == PointerEventKind.cancel) {
                                root.end-drag-window();
                            }
                        }
                    }

                    Image {
                        source: @image-url("../../../data/icons/ui/grip.svg");
                        width: 12px;
                        height: 12px;
                        colorize: drag_ta.has-hover ? #89b4fa : #585b70;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // 2. Brand Logo / About Button
                Rectangle {
                    height: 26px;
                    border-radius: 13px;
                    background: root.active-dialog == 6 ? #89b4fa28 : (btn_logo_ta.has-hover ? #31324466 : transparent);
                    border-width: 1px;
                    border-color: root.active-dialog == 6 ? #89b4fa : (btn_logo_ta.has-hover ? #45475a : transparent);
                    animate background, border-color { duration: 120ms; }

                    btn_logo_ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.active-dialog = root.active-dialog == 6 ? 0 : 6;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 8px;
                        spacing: 5px;
                        alignment: center;

                        Image {
                            source: @image-url("../../../data/icons/64.png");
                            width: 16px;
                            height: 16px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Lekhani";
                            color: root.active-dialog == 6 ? #89b4fa : #cdd6f4;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // Vertical Divider
                Rectangle {
                    width: 1px;
                    height: 16px;
                    background: #31324488;
                }

                // 3. Active Layout Selector Pill Button
                Rectangle {
                    height: 26px;
                    background: root.active-dialog == 1 ? #89b4fa25 : (btn_layout_ta.has-hover ? #31324488 : #1e1e2ecc);
                    border-radius: 13px;
                    border-width: 1px;
                    border-color: root.active-dialog == 1 ? #89b4fa : (btn_layout_ta.has-hover ? #585b70 : #313244);
                    animate background, border-color { duration: 120ms; }

                    btn_layout_ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.active-dialog = root.active-dialog == 1 ? 0 : 1;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 8px;
                        spacing: 5px;
                        alignment: center;
                        Text {
                            text: root.active-layout-name;
                            color: root.active-dialog == 1 ? #89b4fa : #cdd6f4;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Image {
                            source: @image-url("../../../data/icons/ui/chevron_down.svg");
                            width: 9px;
                            height: 9px;
                            colorize: root.active-dialog == 1 ? #89b4fa : #6c7086;
                            vertical-alignment: center;
                        }
                    }
                }

                // Vertical Divider
                Rectangle {
                    width: 1px;
                    height: 16px;
                    background: #31324488;
                }

                // 4. Layout Viewer Button (Keyboard Vector Icon)
                btn_viewer := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/keyboard.svg");
                    active: root.active-dialog == 2;
                    active-color: #89b4fa;
                    active-bg: #89b4fa25;
                    clicked => {
                        root.active-dialog = root.active-dialog == 2 ? 0 : 2;
                    }
                }

                // 5. AutoCorrect Manager Button (Pen Vector Icon)
                btn_ac := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/pen.svg");
                    active: root.active-dialog == 3;
                    active-color: #a6e3a1;
                    active-bg: #a6e3a125;
                    clicked => {
                        root.active-dialog = root.active-dialog == 3 ? 0 : 3;
                    }
                }

                // 6. Bijoy ⇄ Unicode Converter Button (Exchange Vector Icon)
                btn_conv := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/exchange.svg");
                    active: root.active-dialog == 4;
                    active-color: #fab387;
                    active-bg: #fab38725;
                    clicked => {
                        root.active-dialog = root.active-dialog == 4 ? 0 : 4;
                    }
                }

                // 7. Conjunct Assistant Button (Puzzle Vector Icon)
                btn_conjunct := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/puzzle.svg");
                    active: root.active-dialog == 7;
                    active-color: #89dceb;
                    active-bg: #89dceb25;
                    clicked => {
                        root.active-dialog = root.active-dialog == 7 ? 0 : 7;
                    }
                }

                // 8. Personal Typing Telemetry & Speed (Chart Vector Icon)
                btn_stats := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/chart.svg");
                    active: root.active-dialog == 8;
                    active-color: #f9e2af;
                    active-bg: #f9e2af25;
                    clicked => {
                        root.active-dialog = root.active-dialog == 8 ? 0 : 8;
                        if (root.active-dialog == 8) {
                            root.refresh-stats();
                        }
                    }
                }

                // 9. Settings Button (Gear Vector Icon)
                btn_settings := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/settings.svg");
                    active: root.active-dialog == 5;
                    active-color: #cba6f7;
                    active-bg: #cba6f725;
                    clicked => {
                        root.active-dialog = root.active-dialog == 5 ? 0 : 5;
                    }
                }

                // Vertical Divider
                Rectangle {
                    width: 1px;
                    height: 16px;
                    background: #31324488;
                }

                // 10. Exit TopBar Button (Close Vector Icon)
                btn_close := VectorIconButton {
                    icon: @image-url("../../../data/icons/ui/close.svg");
                    icon-color: #f38ba8;
                    active: false;
                    clicked => { root.trigger-quit(); }
                }
            }
        }

        // ---------------------------------------------------------------------
        // Dynamic Floating Tooltip Badge (Integrated into layout, never clipped)
        // ---------------------------------------------------------------------
        if (root.hover-tooltip != "" && root.active-dialog == 0) : Rectangle {
            height: 24px;
            background: #11111bf4;
            border-radius: 12px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000099;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                Text {
                    text: root.hover-tooltip;
                    color: #cdd6f4;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // ---------------------------------------------------------------------
        // 1. Layout Dropdown Popup Panel
        // ---------------------------------------------------------------------
        if (root.active-dialog == 1) : Rectangle {
            width: 260px;
            background: #11111bf8;
            border-radius: 14px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 8px;
                spacing: 3px;
                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text {
                        text: "KEYBOARD LAYOUTS";
                        color: #89b4fa;
                        font-size: 9.5px;
                        font-weight: 800;
                    }
                    CloseButton {
                        clicked => { root.active-dialog = 0; }
                    }
                }
                for layout[idx] in root.available-layouts: Rectangle {
                    height: 30px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: layout == root.active-layout-name ? #89b4fa55 : transparent;
                    background: layout == root.active-layout-name ? #89b4fa20 : (layout_item_ta.has-hover ? #24253a : transparent);
                    animate background { duration: 100ms; }

                    layout_item_ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.select-layout(layout);
                            root.active-dialog = 0;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: space-between;
                        Text {
                            text: layout;
                            color: layout == root.active-layout-name ? #89b4fa : #cdd6f4;
                            font-size: 12px;
                            font-weight: layout == root.active-layout-name ? 700 : 500;
                            vertical-alignment: center;
                        }
                        if (layout == root.active-layout-name) : Text {
                            text: "✓";
                            color: #a6e3a1;
                            font-size: 13px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 2. Visual Keyboard Layout Viewer Dialog
        // ---------------------------------------------------------------------
        if (root.active-dialog == 2) : Rectangle {
            width: 480px;
            background: #11111bf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000bb;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/keyboard.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #89b4fa;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Layout Viewer — " + root.active-layout-name;
                            color: #cdd6f4;
                            font-size: 13.5px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    CloseButton {
                        clicked => { root.active-dialog = 0; }
                    }
                }

                // Mode Segmented Pill Control (Normal / Shift / AltGr)
                Rectangle {
                    height: 28px;
                    background: #0d0e15;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: #24253a;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 3px;
                        SegmentButton {
                            label: "Normal";
                            active: root.viewer-mode == 0;
                            active-color: #89b4fa;
                            clicked => { root.viewer-mode = 0; }
                        }
                        SegmentButton {
                            label: "Shift";
                            active: root.viewer-mode == 1;
                            active-color: #a6e3a1;
                            clicked => { root.viewer-mode = 1; }
                        }
                        SegmentButton {
                            label: "AltGr";
                            active: root.viewer-mode == 2;
                            active-color: #fab387;
                            clicked => { root.viewer-mode = 2; }
                        }
                    }
                }

                // Virtual Keyboard Representation
                Rectangle {
                    background: #0d0e15;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #24253a;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 5px;

                        // Row 1: Numbers
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            for key in (root.viewer-mode == 0 ? ["১", "২", "৩", "৪", "৫", "৬", "৭", "৮", "৯", "০", "-", "="] :
                                       (root.viewer-mode == 1 ? ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "_", "+"] :
                                                                ["১", "২", "৩", "৪", "৫", "৬", "৭", "৮", "৯", "০", "–", "≠"])): KeyCapButton {
                                key-char: key;
                                text-color: #89b4fa;
                            }
                        }
                        // Row 2: QWERTY
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            for key in (root.viewer-mode == 0 ? ["ট", "ঠ", "ড", "ঢ", "ণ", "ত", "থ", "দ", "ধ", "ন", "প", "ফ"] :
                                       (root.viewer-mode == 1 ? ["ৌ", "ৈ", "া", "ী", "ূ", "ভ", "ঙ", "ঘ", "ধ", "ঝ", "ঢ", "খ"] :
                                                                ["৲", "৳", "৴", "৵", "৶", "৷", "৸", "৹", "৺", "৻", "ৎ", "ং"])): KeyCapButton {
                                key-char: key;
                                text-color: #a6e3a1;
                            }
                        }
                        // Row 3: ASDF
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            for key in (root.viewer-mode == 0 ? ["ব", "ভ", "ম", "য", "র", "ল", "শ", "ষ", "স", "হ", "ড়"] :
                                       (root.viewer-mode == 1 ? ["ো", "ে", "্", "ি", "ু", "র", "অ", "আ", "ই", "ঈ", "উ"] :
                                                                ["ঽ", "্", "়", "ঁ", "ঃ", "ৃ", "ৄ", "ৢ", "ৣ", "ৠ", "ঌ"])): KeyCapButton {
                                key-char: key;
                                text-color: #cdd6f4;
                            }
                        }
                        // Row 4: ZXCV
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            for key in (root.viewer-mode == 0 ? ["অ", "আ", "ই", "ঈ", "উ", "ঊ", "ঋ", "এ", "ঐ", "ও", "ঔ"] :
                                       (root.viewer-mode == 1 ? ["য", "শ", "ষ", "স", "হ", "ড়", "ঢ়", "য়", "ৎ", "ং", "ঃ"] :
                                                                ["ঀ", "৾", "৿", "ৢ", "ৣ", "ৄ", "ৠ", "ঌ", "ৡ", "৲", "৳"])): KeyCapButton {
                                key-char: key;
                                text-color: #fab387;
                            }
                        }
                    }
                }

                Text {
                    text: "Tip: In Phonetic mode, type English letters matching sound (e.g. 'ami' ➔ আমি, 'kotha' ➔ কথা).";
                    color: #585b70;
                    font-size: 10.5px;
                    horizontal-alignment: center;
                }
            }
        }

        // ---------------------------------------------------------------------
        // 3. AutoCorrect & Custom Word Dictionary Dialog
        // ---------------------------------------------------------------------
        if (root.active-dialog == 3) : Rectangle {
            width: 480px;
            background: #11111bf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000bb;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/pen.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #a6e3a1;
                            vertical-alignment: center;
                        }
                        Text { text: "AutoCorrect & Custom Dictionary"; color: #cdd6f4; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    CloseButton {
                        clicked => { root.active-dialog = 0; }
                    }
                }

                // Search Bar
                search_input := LineEdit {
                    text: root.ac-search-query;
                    placeholder-text: "Search custom words and autocorrect triggers...";
                    edited(t) => {
                        root.ac-search-query = t;
                        root.ac-search-changed(t);
                    }
                }

                // Add New Entry Form
                Rectangle {
                    background: #0d0e15;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #24253a;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "ADD OR UPDATE WORD"; color: #89b4fa; font-size: 9.5px; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 6px;
                            in_replace := LineEdit {
                                text: root.ac-replace-input;
                                placeholder-text: "Trigger (e.g. kothaa)";
                                edited(t) => {
                                    root.ac-replace-input = t;
                                    root.ac-input-changed(t, in_with.text);
                                }
                            }
                            in_with := LineEdit {
                                text: root.ac-with-input;
                                placeholder-text: "Bengali (e.g. কথা)";
                                edited(t) => {
                                    root.ac-with-input = t;
                                    root.ac-input-changed(in_replace.text, t);
                                }
                            }
                            Button {
                                text: "Add";
                                clicked => {
                                    root.ac-add-or-update(in_replace.text, in_with.text);
                                    root.ac-replace-input = "";
                                    root.ac-with-input = "";
                                }
                            }
                        }
                    }
                }

                // Status bar
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: root.ac-status-text; color: #585b70; font-size: 10.5px; }
                    Text { text: "Syncs live with input engine."; color: #a6e3a1; font-size: 10.5px; }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 4. Bijoy ⇄ Unicode Converter Dialog
        // ---------------------------------------------------------------------
        if (root.active-dialog == 4) : Rectangle {
            width: 480px;
            background: #11111bf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000bb;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/exchange.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #fab387;
                            vertical-alignment: center;
                        }
                        Text { text: "Bijoy (ANSI) ⇄ Unicode Converter"; color: #cdd6f4; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    CloseButton {
                        clicked => { root.active-dialog = 0; }
                    }
                }

                Text { text: "Input Text (Bijoy or Unicode):"; color: #a6adc8; font-size: 11px; font-weight: 600; }
                in_conv_edit := LineEdit {
                    text: root.conv-input-text;
                    placeholder-text: "Type or paste text (e.g. Avwg evsjvq Mvb MvB)...";
                    edited(t) => { root.conv-input-text = t; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Bijoy (ANSI) ➔ Unicode";
                        clicked => { root.convert-bijoy-to-unicode(in_conv_edit.text); }
                    }
                    Button {
                        text: "Unicode ➔ Bijoy (ANSI)";
                        clicked => { root.convert-unicode-to-bijoy(in_conv_edit.text); }
                    }
                }

                Text { text: "Converted Output:"; color: #a6adc8; font-size: 11px; font-weight: 600; }
                Rectangle {
                    height: 56px;
                    background: #0d0e15;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #24253a;
                    Text {
                        text: root.conv-output-text != "" ? root.conv-output-text : "Converted text will appear here...";
                        color: root.conv-output-text != "" ? #a6e3a1 : #45475a;
                        font-size: 13px;
                        x: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 5. Settings Dialog Window
        // ---------------------------------------------------------------------
        if (root.active-dialog == 5) : Rectangle {
            width: 480px;
            background: #11111bf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000bb;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/settings.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #cba6f7;
                            vertical-alignment: center;
                        }
                        Text { text: "Preferences & Settings"; color: #cdd6f4; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    CloseButton {
                        clicked => { root.active-dialog = 0; }
                    }
                }

                // Section 1: Phonetic Options
                Rectangle {
                    background: #0d0e15;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #24253a;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 5px;
                        Text { text: "PHONETIC TYPING OPTIONS"; color: #89b4fa; font-size: 9.5px; font-weight: 700; }
                        CheckBox { text: "Enable Prefix Trie Dictionary Suggestions"; checked: root.set-use-dict; toggled => { root.set-use-dict = self.checked; } }
                        CheckBox { text: "Include Original English in Candidate List"; checked: root.set-include-eng; toggled => { root.set-include-eng = self.checked; } }
                        CheckBox { text: "Enter Key Closes Candidate Window"; checked: root.set-enter-closes; toggled => { root.set-enter-closes = self.checked; } }
                        CheckBox { text: "Proactive AI Next-Word Prediction (Zero-Preedit)"; checked: root.set-predictive-next; toggled => { root.set-predictive-next = self.checked; } }
                        CheckBox { text: "Auto-Expand Double Period (..) to Bengali Dāri (।)"; checked: root.set-auto-dari; toggled => { root.set-auto-dari = self.checked; } }
                        CheckBox { text: "Show Mode-Switch OSD HUD Overlay on Toggle"; checked: root.set-show-osd; toggled => { root.set-show-osd = self.checked; } }

                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Global Toggle Hotkey:"; color: #cdd6f4; font-size: 11px; vertical-alignment: center; }
                            SegmentButton {
                                label: "F12";
                                active: root.set-toggle-key == "F12";
                                active-color: #89b4fa;
                                clicked => { root.set-toggle-key = "F12"; }
                            }
                            SegmentButton {
                                label: "Ctrl+Space";
                                active: root.set-toggle-key == "Ctrl+Space";
                                active-color: #89b4fa;
                                clicked => { root.set-toggle-key = "Ctrl+Space"; }
                            }
                            SegmentButton {
                                label: "Shift+Space";
                                active: root.set-toggle-key == "Shift+Space";
                                active-color: #89b4fa;
                                clicked => { root.set-toggle-key = "Shift+Space"; }
                            }
                        }
                    }
                }

                // Section 2: Fixed Layout Automations
                Rectangle {
                    background: #0d0e15;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #24253a;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 5px;
                        Text { text: "FIXED LAYOUT AUTOMATIONS"; color: #a6e3a1; font-size: 9.5px; font-weight: 700; }
                        CheckBox { text: "Automatic Vowel Forming (অ + া ➔ আ)"; checked: root.set-auto-vowel; toggled => { root.set-auto-vowel = self.checked; } }
                        CheckBox { text: "Automatic Chandra Position Fixing (কঁ + া ➔ কাঁ)"; checked: root.set-auto-chandra; toggled => { root.set-auto-chandra = self.checked; } }
                        CheckBox { text: "Traditional Kar Joining & Ligature ZWNJ Blocking"; checked: root.set-traditional-kar; toggled => { root.set-traditional-kar = self.checked; } }
                        CheckBox { text: "Smart Old-Style Reph (র্) Insertion"; checked: root.set-old-reph; toggled => { root.set-old-reph = self.checked; } }
                        CheckBox { text: "Map Numeric Keypad to Bengali Digits (০-৯)"; checked: root.set-numberpad; toggled => { root.set-numberpad = self.checked; } }
                    }
                }

                // Section 3: System & Startup (Windows)
                if root.is-windows : Rectangle {
                    background: #0d0e15;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #24253a;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 5px;
                        Text { text: "SYSTEM & STARTUP"; color: #f9e2af; font-size: 9.5px; font-weight: 700; }
                        CheckBox { text: "Launch Lekhani on Windows startup"; checked: root.set-autostart; toggled => { root.set-autostart = self.checked; } }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Save Preferences";
                        clicked => { root.save-settings(); }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 6. About Dialog Window
        // ---------------------------------------------------------------------
        if (root.active-dialog == 6) : Rectangle {
            width: 420px;
            background: #11111bf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000bb;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 52px;
                    height: 52px;
                    background: #0d0e15;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #89b4fa55;
                    drop-shadow-blur: 14px;
                    drop-shadow-color: #89b4fa33;
                    
                    Image {
                        source: @image-url("../../../data/icons/128.png");
                        width: 40px;
                        height: 40px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text { text: "Lekhani (লেখনী)"; color: #cdd6f4; font-size: 17px; font-weight: 800; horizontal-alignment: center; }
                Text { text: "Version 1.0.0 • Pure Rust Architecture"; color: #89b4fa; font-size: 12px; font-weight: 600; horizontal-alignment: center; }
                Text { text: "Author: Sintaul Mahdi Siam • Syntenieum (2026)"; color: #a6e3a1; font-size: 11px; font-weight: 600; horizontal-alignment: center; }
                Text { text: "© 2026 Syntenieum. All rights reserved."; color: #89dceb; font-size: 10.5px; font-weight: 500; horizontal-alignment: center; }
                Text {
                    text: "Modern, Ultra-Fast Bengali Input Method Framework & Desktop Suite for Linux & Windows";
                    color: #a6adc8;
                    font-size: 11.5px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 1px;
                    background: #24253a;
                }

                Text {
                    text: "Special thanks to Avro Project (OmicronLab) & OpenBangla Keyboard for their pioneering foundations in Bengali computing.";
                    color: #f9e2af;
                    font-size: 10px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Button {
                    text: "Close";
                    clicked => { root.active-dialog = 0; }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 7. Bengali Conjunct Assistant ("যুক্তবর্ণ সহায়িকা")
        // ---------------------------------------------------------------------
        if (root.active-dialog == 7) : Rectangle {
            width: 480px;
            background: #11111bf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000bb;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/puzzle.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #89dceb;
                            vertical-alignment: center;
                        }
                        Text { text: "যুক্তবর্ণ সহায়িকা (Conjunct Assistant)"; color: #cdd6f4; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    CloseButton {
                        clicked => { root.active-dialog = 0; }
                    }
                }

                // Search Bar
                LineEdit {
                    text: root.conjunct-search-query;
                    placeholder-text: "Search conjunct, breakdown, or phonetic keys (e.g. ক্ষ, kkh, হ + ্ + ম)...";
                    edited(t) => {
                        root.conjunct-search-query = t;
                        root.conjunct-search-changed(t);
                    }
                }

                // Scrollable Conjunct Grid/List
                Rectangle {
                    height: 200px;
                    background: #0d0e15;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #24253a;
                    clip: true;

                    ListView {
                        for item[idx] in root.conjunct-list : Rectangle {
                            height: 48px;
                            background: Math.mod(idx, 2) == 0 ? #14152288 : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: space-between;

                                // Conjunct glyph & breakdown
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 7px;
                                        background: #89b4fa20;
                                        border-width: 1px;
                                        border-color: #89b4fa44;
                                        Text {
                                            text: item.conjunct;
                                            color: #89b4fa;
                                            font-size: 17px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Text {
                                            text: item.breakdown;
                                            color: #cdd6f4;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "Examples: " + item.examples;
                                            color: #a6adc8;
                                            font-size: 10px;
                                        }
                                    }
                                }

                                // Phonetic key badge & copy button
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;
                                    Rectangle {
                                        border-radius: 5px;
                                        background: #a6e3a120;
                                        border-width: 1px;
                                        border-color: #a6e3a144;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;
                                            Text {
                                                text: item.phonetic;
                                                color: #a6e3a1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Button {
                                        text: "Copy";
                                        clicked => {
                                            root.copy-conjunct(item.conjunct);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Tip footer
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Tip: Search by Latin sequence (e.g. 'kkh' or 'ggy')."; color: #585b70; font-size: 10.5px; }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 8. Personal Typing Analytics & Speed Heatmap Dashboard
        // ---------------------------------------------------------------------
        if (root.active-dialog == 8) : Rectangle {
            width: 480px;
            background: #11111bf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #45475a88;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000bb;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../data/icons/ui/chart.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #f9e2af;
                            vertical-alignment: center;
                        }
                        Text { text: "Typing Telemetry & Analytics"; color: #cdd6f4; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: ta_ref.has-hover ? #31324488 : transparent;
                            border-width: 1px;
                            border-color: ta_ref.has-hover ? #45475a : transparent;
                            ta_ref := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.refresh-stats(); }
                            }
                            Image {
                                source: @image-url("../../../data/icons/ui/refresh.svg");
                                width: 12px;
                                height: 12px;
                                colorize: ta_ref.has-hover ? #f9e2af : #a6adc8;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        CloseButton {
                            clicked => { root.active-dialog = 0; }
                        }
                    }
                }

                // Summary Metric Cards
                HorizontalLayout {
                    spacing: 8px;

                    // Card 1: Words Typed
                    Rectangle {
                        background: #0d0e15;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #89b4fa44;
                        height: 60px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding: 6px;
                            Text { text: "WORDS COMMITTED"; color: #89b4fa; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: root.stats-total-words; color: #cdd6f4; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        }
                    }

                    // Card 2: Keystrokes Saved
                    Rectangle {
                        background: #0d0e15;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #a6e3a144;
                        height: 60px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding: 6px;
                            Text { text: "KEYSTROKES SAVED"; color: #a6e3a1; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: root.stats-keystrokes-saved; color: #cdd6f4; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        }
                    }

                    // Card 3: Efficiency Gain
                    Rectangle {
                        background: #0d0e15;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #fab38744;
                        height: 60px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding: 6px;
                            Text { text: "EFFICIENCY GAIN"; color: #fab387; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: root.stats-efficiency-ratio; color: #cdd6f4; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        }
                    }
                }

                // Character Frequency Table
                Rectangle {
                    height: 140px;
                    background: #0d0e15;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #24253a;
                    clip: true;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: "MOST FREQUENTLY TYPED BENGALI CHARACTERS"; color: #f9e2af; font-size: 9.5px; font-weight: 700; }
                        ListView {
                            for char_entry in root.stats-top-chars : HorizontalLayout {
                                padding-top: 2px;
                                padding-bottom: 2px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: char_entry.character; color: #89b4fa; font-size: 13px; font-weight: 700; width: 28px; }
                                    Text { text: char_entry.count + " times"; color: #a6adc8; font-size: 11px; }
                                }
                                Text { text: char_entry.percentage; color: #a6e3a1; font-size: 11px; font-weight: 600; }
                            }
                        }
                    }
                }

                // Footer
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Telemetry is stored 100% locally and never leaves your device."; color: #585b70; font-size: 10px; }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 9. Mode-Switch OSD HUD Overlay (Activated on F12 / Layout Toggle)
        // ---------------------------------------------------------------------
        if (root.show-osd) : HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 320px;
                height: 48px;
                background: #11111bf4;
                border-radius: 14px;
                border-width: 1.5px;
                border-color: root.osd-badge-color;
                drop-shadow-blur: 20px;
                drop-shadow-color: #000000dd;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    alignment: center;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: root.osd-badge-bg;
                        border-width: 1px;
                        border-color: root.osd-badge-color;

                        Text {
                            text: root.osd-icon;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.osd-title;
                            font-size: 12px;
                            font-weight: 800;
                            color: #cdd6f4;
                        }
                        Text {
                            text: root.osd-subtitle;
                            font-size: 10.5px;
                            font-weight: 600;
                            color: root.osd-badge-color;
                        }
                    }

                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: #313244;
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: 5px;
                        background: #24253a;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            alignment: center;
                            Text {
                                text: "F12";
                                font-size: 10px;
                                font-weight: 700;
                                color: #89b4fa;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

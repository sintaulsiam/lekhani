// Lekhani Common Slint Structs and Reusable UI Components

import {
    Button,
    LineEdit,
    TextEdit,
    CheckBox,
    ListView,
    ScrollView,
} from "std-widgets.slint";

// Struct for AutoCorrect list display
export struct AcEntry {
    trigger: string,
    replacement: string,
}

// Struct for Bengali Conjunct display
export struct ConjunctEntry {
    conjunct: string,
    breakdown: string,
    phonetic: string,
    examples: string,
}

// Struct for Typing Analytics Heatmap display
export struct HeatmapEntry {
    character: string,
    count: int,
    percentage: string,
}

export component VectorIconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <color> icon-color: #a6adc8;
    in property <color> active-color: #89b4fa;
    in property <color> active-bg: #89b4fa25;
    in property <color> active-border: #89b4fa55;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.active ? root.active-border : (ta.has-hover ? #45475a88 : transparent);
    background: root.active ? root.active-bg : (ta.has-hover ? #ffffff14 : transparent);
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        width: 14px;
        height: 14px;
        colorize: root.active ? root.active-color : (ta.has-hover ? #ffffff : root.icon-color);
    }
}

export component CloseButton inherits Rectangle {
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.has-hover ? #f38ba828 : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? #f38ba855 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("../../../data/icons/ui/close.svg");
        width: 12px;
        height: 12px;
        colorize: ta.has-hover ? #f38ba8 : #6c7086;
    }
}

export component PopoutButton inherits Rectangle {
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.has-hover ? #89b4fa28 : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa55 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("../../../data/icons/ui/popout.svg");
        width: 12px;
        height: 12px;
        colorize: ta.has-hover ? #89b4fa : #6c7086;
    }
}

export component HeaderIcon inherits Rectangle {
    in property <image> source;
    in property <color> colorize: #89b4fa;
    in property <length> icon-size: 16px;

    width: root.icon-size + 2px;
    height: 24px;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.source;
        width: root.icon-size;
        height: root.icon-size;
        colorize: root.colorize;
    }
}

export component SegmentButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <color> active-color: #3b82f6;
    callback clicked;

    height: 26px;
    border-radius: 6px;
    background: root.active ? #1e293b : (ta.has-hover ? #151a24 : transparent);
    border-width: 1px;
    border-color: root.active ? #38bdf888 : (ta.has-hover ? #252e42 : transparent);
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? #ffffff : (ta.has-hover ? #e2e8f0 : #94a3b8);
                font-size: 11.5px;
                font-weight: root.active ? 700 : 500;
            }
        }
    }
}

export component BrandLogo inherits Rectangle {
    in property <bool> active: false;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    height: 26px;
    border-radius: 13px;
    background: root.active ? #89b4fa25 : (ta.has-hover ? #24273a88 : transparent);
    border-width: 1px;
    border-color: root.active ? #89b4fa66 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 9px;
            spacing: 6px;
            alignment: center;

            Image {
                source: @image-url("../../../data/icons/ui/logo.svg");
                width: 16px;
                height: 16px;
                horizontal-alignment: center;
            }

            Text {
                text: "Lekhani";
                color: root.active ? #89b4fa : #f8fafc;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

export component LayoutSelectorPill inherits Rectangle {
    in property <string> layout-name;
    in property <bool> active: false;
    in property <bool> is-bengali: true;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    height: 26px;
    background: root.active ? #25283d : (ta.has-hover ? #24273a : #181926bb);
    border-radius: 13px;
    border-width: 1px;
    border-color: root.active ? #89b4fa88 : (ta.has-hover ? #585b70 : #33364d);
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 11px;
            padding-right: 9px;
            spacing: 5px;
            alignment: center;

            Text {
                text: root.layout-name;
                color: root.active ? #89b4fa : #cdd6f4;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                padding-top: 2px;
                Image {
                    source: @image-url("../../../data/icons/ui/chevron_down.svg");
                    width: 9px;
                    height: 9px;
                    colorize: root.active ? #89b4fa : (ta.has-hover ? #cdd6f4 : #9399b2);
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component KeyCapButton inherits Rectangle {
    in property <string> key-char;
    in property <string> latin-char: "";
    in property <color> text-color: #e2e8f0;
    in property <length> key-width: 34px;
    in property <length> key-height: 30px;
    in property <int> flex-stretch: 1;

    min-width: 24px;
    preferred-width: root.key-width;
    min-height: 26px;
    preferred-height: root.key-height;
    horizontal-stretch: root.flex-stretch;
    vertical-stretch: 1;
    border-radius: 6px;
    background: ta.has-hover ? #2a2d42 : #181926;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa88 : #2d3045;
    animate background, border-color { duration: 80ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
    }

    if (root.latin-char != ""): Text {
        x: parent.width - self.width - 4px;
        y: 2px;
        text: root.latin-char;
        color: #64748b;
        font-size: 8.5px;
        font-weight: 600;
    }

    VerticalLayout {
        alignment: center;
        Text {
            text: root.key-char;
            color: root.text-color;
            font-size: 13.5px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component ModernButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> btn-color: #89b4fa;
    in property <bool> primary: false;
    in property <bool> danger: false;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    height: 30px;
    border-radius: 7px;
    background: root.danger ? (ta.has-hover ? #dc2626 : #8a1919) :
                root.primary ? (ta.has-hover ? #3b82f6 : #2563eb) :
                (ta.has-hover ? #22293a : #151822);
    border-width: 1px;
    border-color: root.danger ? (ta.has-hover ? #f87171 : #ef4444aa) :
                  root.primary ? #60a5fa88 :
                  (ta.has-hover ? #3d4963 : #222838);
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 6px;
            alignment: center;

            if (root.has-icon): Image {
                width: 13px;
                height: 13px;
                source: root.icon;
                colorize: (root.primary || root.danger) ? #ffffff : (ta.has-hover ? #ffffff : #94a3b8);
                vertical-alignment: center;
            }

            Text {
                text: root.text;
                color: (root.primary || root.danger) ? #ffffff : (ta.has-hover ? #ffffff : #f1f5f9);
                font-size: 11.5px;
                font-weight: (root.primary || root.danger) ? 700 : 600;
                vertical-alignment: center;
            }
        }
    }
}

export component ConfirmModal inherits Rectangle {
    in property <string> title: "Confirm Action";
    in property <string> message: "Are you sure you want to proceed?";
    in property <string> confirm-text: "Confirm";
    in property <bool> is-danger: true;
    callback confirm();
    callback cancel();

    background: #000000bd;

    TouchArea {
        // block clicks from passing through
    }

    Rectangle {
        width: min(parent.width - 40px, 430px);
        height: card-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #0f111a;
        border-radius: 14px;
        border-width: 1.2px;
        border-color: root.is-danger ? #f38ba866 : #89b4fa66;
        drop-shadow-blur: 36px;
        drop-shadow-color: #000000f0;

        card-layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;

            // Header: Warning Badge + Titles
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    background: root.is-danger ? #f38ba818 : #89b4fa18;
                    border-width: 1px;
                    border-color: root.is-danger ? #f38ba844 : #89b4fa44;

                    Image {
                        width: 20px;
                        height: 20px;
                        source: root.is-danger ? @image-url("../../../data/icons/ui/warning.svg") : @image-url("../../../data/icons/ui/settings.svg");
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.title;
                        color: #f8fafc;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.is-danger ? "Irreversible Operation" : "Preference Change";
                        color: root.is-danger ? #f38ba8 : #89b4fa;
                        font-size: 10.5px;
                        font-weight: 600;
                    }
                }
            }

            // Body callout box
            Rectangle {
                background: root.is-danger ? #1f1319 : #141724;
                border-radius: 9px;
                border-width: 1px;
                border-color: root.is-danger ? #f38ba833 : #89b4fa33;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        text: root.message;
                        color: #cbd5e1;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            // Actions
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                padding-top: 4px;

                ModernButton {
                    text: "Cancel";
                    primary: false;
                    clicked => { root.cancel(); }
                }

                ModernButton {
                    text: root.confirm-text;
                    icon: root.is-danger ? @image-url("../../../data/icons/ui/trash.svg") : @image-url("../../../data/icons/ui/settings.svg");
                    has-icon: true;
                    danger: root.is-danger;
                    primary: !root.is-danger;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}

export component ModernToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    callback toggled(bool);

    height: 26px;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        alignment: space-between;
        Text {
            text: root.label;
            color: ta.has-hover ? #ffffff : #e2e8f0;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }

        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            y: (parent.height - self.height) / 2;
            background: root.checked ? #3b82f6 : #1a1f2c;
            border-width: 1px;
            border-color: root.checked ? #60a5fa : #2a3348;
            animate background, border-color { duration: 120ms; }

            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: #ffffff;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                y: 2px;
                animate x { duration: 120ms; }
            }
        }
    }
}

export component CopyButton inherits Rectangle {
    callback clicked;
    in property <bool> copied: false;
    out property <bool> has-hover: ta.has-hover;

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? #89b4fa22 : #181926aa;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa66 : #2d3045;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        Image {
            source: @image-url("../../../data/icons/ui/copy.svg");
            width: 13px;
            height: 13px;
            colorize: root.copied ? #a6e3a1 : (ta.has-hover ? #89b4fa : #a6adc8);
            horizontal-alignment: center;
        }
    }
}

export component SidebarTabItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <color> active-color: #89b4fa;
    in property <string> badge: "";
    callback clicked;

    height: 38px;
    border-radius: 8px;
    background: root.active ? #89b4fa18 : (ta.has-hover ? #ffffff08 : transparent);
    border-width: 1px;
    border-color: root.active ? #89b4fa33 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Active indicator line on the left border
    if (root.active): Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 18px;
        border-top-right-radius: 1.5px;
        border-bottom-right-radius: 1.5px;
        background: root.active-color;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        // Icon in fixed container so all icons align perfectly on vertical axis
        Rectangle {
            width: 18px;
            height: 18px;
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.active ? root.active-color : (ta.has-hover ? #cdd6f4 : #7f849c);
                animate colorize { duration: 100ms; }
            }
        }

        // Label
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: root.active ? #f8fafc : (ta.has-hover ? #cdd6f4 : #9399b2);
                font-size: 12px;
                font-weight: root.active ? 700 : 500;
                overflow: elide;
                vertical-alignment: center;
                animate color { duration: 100ms; }
            }
        }

        if (root.badge != ""): VerticalLayout {
            alignment: center;
            Rectangle {
                border-radius: 4px;
                background: root.active ? #89b4fa33 : #313244;
                VerticalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text {
                        text: root.badge;
                        font-size: 9.5px;
                        font-weight: 700;
                        color: root.active ? #89b4fa : #a6adc8;
                    }
                }
            }
        }
    }
}

export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <bool> has-divider: true;
    in-out property <bool> checked: false;
    in property <bool> show-switch: true;
    callback toggled(bool);

    border-radius: 8px;
    background: ta.has-hover ? #ffffff05 : transparent;
    animate background { duration: 80ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.show-switch) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 0px;

        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.title;
                    color: #f1f5f9;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                if (root.subtitle != ""): Text {
                    text: root.subtitle;
                    color: #828ba2;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
            }

            if (root.show-switch): VerticalLayout {
                alignment: center;
                ModernToggleSwitch {
                    checked <=> root.checked;
                    toggled(val) => { root.toggled(val); }
                }
            }
        }

        if (root.has-divider): Rectangle {
            height: 1px;
            background: #1e203055;
        }
    }
}

export component SettingCard inherits Rectangle {
    in property <string> title;
    in property <color> title-color: #89b4fa;
    in property <image> icon;

    background: #0c0d14;
    border-radius: 12px;
    border-width: 1px;
    border-color: #242638;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;

        if (root.title != ""): HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if (root.icon.width > 0): Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: root.title-color;
                vertical-alignment: center;
            }
            Text {
                text: root.title;
                color: root.title-color;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }
        }

        @children
    }
}

export component EmptyStateView inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: #89b4fa;
    in property <string> title: "No items found";
    in property <string> message: "";
    in property <string> subtitle: "";

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 24px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                background: #89b4fa18;
                border-width: 1px;
                border-color: #89b4fa33;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.icon;
                        width: 22px;
                        height: 22px;
                        colorize: root.icon-color;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        Text {
            text: root.title;
            color: #e2e8f0;
            font-size: 13.5px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        if (root.subtitle != "" || root.message != ""): Text {
            text: root.subtitle != "" ? root.subtitle : root.message;
            color: #94a3b8;
            font-size: 11.5px;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 320px;
        }
    }
}

export component SettingsContent inherits ScrollView {
    in property <int> active-tab: 0;
    in property <bool> is-windows: false;
    in property <string> learned-stats-text: "";

    // Preferences
    in-out property <bool> set-dark-mode;
    in-out property <bool> set-horizontal-cands;
    in-out property <bool> set-auto-dari;
    in-out property <bool> set-show-osd;
    in-out property <bool> set-check-updates;
    in-out property <bool> set-autostart;
    in-out property <string> set-toggle-key;

    in-out property <bool> set-use-dict;
    in-out property <bool> set-include-eng;
    in-out property <bool> set-enter-closes;

    in-out property <bool> set-auto-vowel;
    in-out property <bool> set-auto-chandra;
    in-out property <bool> set-traditional-kar;
    in-out property <bool> set-old-reph;
    in-out property <bool> set-numberpad;

    in-out property <bool> set-predictive-next;
    in-out property <bool> set-reduplication;
    in-out property <bool> set-phrase-prediction;
    in-out property <bool> set-dynamic-macros;
    in-out property <bool> set-code-shield;
    in-out property <bool> set-word-segmentation;
    in-out property <bool> set-colloquial-dialects;
    in-out property <bool> set-banglish-shorthand;

    callback auto-save();
    callback export-backup();
    callback restore-backup();
    callback export-vocabulary();
    callback import-vocabulary();
    callback request-clear-learned();
    callback request-restore-defaults();

    vertical-stretch: 1;
    horizontal-stretch: 1;

    VerticalLayout {
        spacing: 14px;
        alignment: start;
        padding-right: 6px;

        // TAB 0: GENERAL PREFERENCES
        if (root.active-tab == 0): VerticalLayout {
            spacing: 12px;

            SettingCard {
                title: "GENERAL PREFERENCES";
                title-color: #cba6f7;
                icon: @image-url("../../../data/icons/ui/settings.svg");

                SettingRow {
                    title: "Dark Theme Appearance";
                    subtitle: "Enable sleek dark palette across all Lekhani windows and menus";
                    checked <=> root.set-dark-mode;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Horizontal Candidate Window Layout";
                    subtitle: "Display phonetic suggestions side-by-side instead of vertically";
                    checked <=> root.set-horizontal-cands;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Auto-Expand Double Period (..) to Dāri (।)";
                    subtitle: "Quickly type Bengali dāri punctuation by typing double full-stops";
                    checked <=> root.set-auto-dari;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Show Mode-Switch HUD Overlay";
                    subtitle: "Display an on-screen visual notification when switching layouts";
                    checked <=> root.set-show-osd;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Automatically Check for Updates";
                    subtitle: "Keep Lekhani up to date with new features and dictionary releases";
                    checked <=> root.set-check-updates;
                    toggled(_) => { root.auto-save(); }
                }

                if (root.is-windows): SettingRow {
                    title: "Launch on System Startup";
                    subtitle: "Start Lekhani in the Windows system notification tray on boot";
                    checked <=> root.set-autostart;
                    toggled(_) => { root.auto-save(); }
                }

                // Mode Toggle Hotkey Row
                Rectangle {
                    border-radius: 8px;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Mode Toggle Hotkey";
                                    color: #f1f5f9;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Global keyboard shortcut to switch between Bengali & English";
                                    color: #828ba2;
                                    font-size: 10.5px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;

                                SegmentButton {
                                    label: "F12";
                                    active: root.set-toggle-key == "F12";
                                    active-color: #cba6f7;
                                    clicked => {
                                        root.set-toggle-key = "F12";
                                        root.auto-save();
                                    }
                                }
                                SegmentButton {
                                    label: "Ctrl+Space";
                                    active: root.set-toggle-key == "Ctrl+Space";
                                    active-color: #cba6f7;
                                    clicked => {
                                        root.set-toggle-key = "Ctrl+Space";
                                        root.auto-save();
                                    }
                                }
                                SegmentButton {
                                    label: "Shift+Space";
                                    active: root.set-toggle-key == "Shift+Space";
                                    active-color: #cba6f7;
                                    clicked => {
                                        root.set-toggle-key = "Shift+Space";
                                        root.auto-save();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 1: PHONETIC & BASIC TYPING
        if (root.active-tab == 1): VerticalLayout {
            spacing: 12px;

            SettingCard {
                title: "PHONETIC & BASIC TYPING";
                title-color: #89b4fa;
                icon: @image-url("../../../data/icons/ui/keyboard.svg");

                SettingRow {
                    title: "Enable Dictionary Suggestions";
                    subtitle: "Offer intelligent phonetic candidate completions as you type in Roman letters";
                    checked <=> root.set-use-dict;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Include English in Candidate List";
                    subtitle: "Allow choosing the verbatim English word from the suggestion window";
                    checked <=> root.set-include-eng;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Enter Key Closes Candidate Window";
                    subtitle: "Pressing Enter commits the primary candidate and immediately closes popup";
                    checked <=> root.set-enter-closes;
                    has-divider: false;
                    toggled(_) => { root.auto-save(); }
                }
            }

            SettingCard {
                title: "AUTONOMOUS LEARNING PROFILE";
                title-color: #89b4fa;
                icon: @image-url("../../../data/icons/ui/chart.svg");

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Active Model Memory:";
                        color: #94a3b8;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.learned-stats-text;
                        color: #89b4fa;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Lekhani continuously trains local n-grams and bigram transitions from your accepted selections. Your personalized vocabulary stays 100% private on your device.";
                    color: #64748b;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // TAB 2: FIXED LAYOUT AUTOMATIONS
        if (root.active-tab == 2): VerticalLayout {
            spacing: 12px;

            SettingCard {
                title: "FIXED LAYOUT AUTOMATIONS (PROBHAT / JATIYA / UNIBIJOY)";
                title-color: #a6e3a1;
                icon: @image-url("../../../data/icons/ui/puzzle.svg");

                SettingRow {
                    title: "Automatic Vowel Forming";
                    subtitle: "Converts standalone kars into independent vowel letters (e.g. অ + া ➔ আ)";
                    checked <=> root.set-auto-vowel;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Automatic Chandra Position";
                    subtitle: "Ensures Chandrabindu is automatically attached to the consonant (ক + ঁ ➔ কাঁ)";
                    checked <=> root.set-auto-chandra;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Traditional Kar Placement";
                    subtitle: "Maintains classical visual typing sequence for pre-kars and post-kars";
                    checked <=> root.set-traditional-kar;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Smart Reph Placement";
                    subtitle: "Automatically repositions Bengali Reph (র্) before the appropriate root consonant";
                    checked <=> root.set-old-reph;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Bengali Number Pad Mapping";
                    subtitle: "Maps physical numeric keypad digits directly to Bengali numerals (০-৯)";
                    checked <=> root.set-numberpad;
                    has-divider: false;
                    toggled(_) => { root.auto-save(); }
                }
            }
        }

        // TAB 3: SMART ASSISTANCE & AI
        if (root.active-tab == 3): VerticalLayout {
            spacing: 12px;

            SettingCard {
                title: "PREDICTIVE INTELLIGENCE & PRODUCTIVITY";
                title-color: #f38ba8;
                icon: @image-url("../../../data/icons/ui/chart.svg");

                SettingRow {
                    title: "AI Next-Word Prediction";
                    subtitle: "Suggests the most probable next word using neural n-gram context";
                    checked <=> root.set-predictive-next;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Reduplicated Words Prediction";
                    subtitle: "Auto-completes repeated Bengali echo expressions (e.g. ধীরে ➔ ধীরে ধীরে)";
                    checked <=> root.set-reduplication;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Multi-Word Phrase Completion";
                    subtitle: "Predicts common multi-word idioms and conversational collocations";
                    checked <=> root.set-phrase-prediction;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Dynamic Math & Date Macros";
                    subtitle: "Evaluates inline calculations like !sum(10+20) and dates like !date";
                    checked <=> root.set-dynamic-macros;
                    has-divider: false;
                    toggled(_) => { root.auto-save(); }
                }
            }

            SettingCard {
                title: "DEVELOPER TOOLS & REGIONAL DIALECTS";
                title-color: #f38ba8;
                icon: @image-url("../../../data/icons/ui/settings.svg");

                SettingRow {
                    title: "Developer Code Shield";
                    subtitle: "Guards programming keywords (onClick, function, const, --flag) from transliteration";
                    checked <=> root.set-code-shield;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Concatenated Word Segmentation";
                    subtitle: "Splits combined phonetics into proper spaced words (kemonaso ➔ কেমন আছো)";
                    checked <=> root.set-word-segmentation;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Colloquial Dialect Normalization";
                    subtitle: "Maps spoken regional dialects into standard literary Bengali (খামু ➔ খাব)";
                    checked <=> root.set-colloquial-dialects;
                    toggled(_) => { root.auto-save(); }
                }

                SettingRow {
                    title: "Banglish Chat Contractions";
                    subtitle: "Expands popular SMS and social media chat shortcuts (amr ➔ আমার, kothay ➔ কোথায়)";
                    checked <=> root.set-banglish-shorthand;
                    has-divider: false;
                    toggled(_) => { root.auto-save(); }
                }
            }
        }

        // TAB 4: DATA & BACKUP MANAGEMENT
        if (root.active-tab == 4): VerticalLayout {
            spacing: 12px;

            SettingCard {
                title: "DATA & BACKUP MANAGEMENT";
                title-color: #38bdf8;
                icon: @image-url("../../../data/icons/ui/database.svg");

                VerticalLayout {
                    spacing: 12px;

                    // Card 1: Full Workspace Backup
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #0f111a;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: #23273a;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 7px;
                                        background: #89b4fa15;
                                        border-width: 1px;
                                        border-color: #89b4fa33;
                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 16px;
                                            height: 16px;
                                            source: @image-url("../../../data/icons/ui/database.svg");
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "Full Workspace Archive";
                                            color: #f1f5f9;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: "Complete system backup (.json)";
                                            color: #89b4fa;
                                            font-size: 10.5px;
                                            font-weight: 600;
                                        }
                                    }
                                }

                                Text {
                                    text: "Archive your complete configuration, custom layouts, autocorrect table, typing memory, and statistics.";
                                    color: #94a3b8;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                ModernButton {
                                    text: "Export Backup...";
                                    icon: @image-url("../../../data/icons/ui/download.svg");
                                    has-icon: true;
                                    primary: false;
                                    clicked => { root.export-backup(); }
                                }
                                ModernButton {
                                    text: "Restore Backup...";
                                    icon: @image-url("../../../data/icons/ui/upload.svg");
                                    has-icon: true;
                                    primary: false;
                                    clicked => { root.restore-backup(); }
                                }
                            }
                        }
                    }

                    // Card 2: Learned Vocabulary
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #0f111a;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: #23273a;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 7px;
                                        background: #cba6f715;
                                        border-width: 1px;
                                        border-color: #cba6f733;
                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 16px;
                                            height: 16px;
                                            source: @image-url("../../../data/icons/ui/book.svg");
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "Learned Vocabulary";
                                            color: #f1f5f9;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: "Personalized language model (.json)";
                                            color: #cba6f7;
                                            font-size: 10.5px;
                                            font-weight: 600;
                                        }
                                    }
                                }

                                Text {
                                    text: "Export or import only your autonomously learned vocabulary, candidate memory, and dynamic bigram transitions.";
                                    color: #94a3b8;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                ModernButton {
                                    text: "Export Vocabulary...";
                                    icon: @image-url("../../../data/icons/ui/download.svg");
                                    has-icon: true;
                                    primary: false;
                                    clicked => { root.export-vocabulary(); }
                                }
                                ModernButton {
                                    text: "Import Vocabulary...";
                                    icon: @image-url("../../../data/icons/ui/upload.svg");
                                    has-icon: true;
                                    primary: false;
                                    clicked => { root.import-vocabulary(); }
                                }
                            }
                        }
                    }
                }
            }

            // Danger Zone Card
            Rectangle {
                background: #181014;
                border-radius: 10px;
                border-width: 1px;
                border-color: #f38ba833;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 7px;
                            background: #f38ba818;
                            border-width: 1px;
                            border-color: #f38ba844;
                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../../data/icons/ui/warning.svg");
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Danger Zone";
                                color: #f87171;
                                font-size: 12px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Permanently erase learned models or restore all settings back to defaults";
                                color: #fca5a5;
                                font-size: 10.5px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        ModernButton {
                            text: "Reset Learned Data...";
                            icon: @image-url("../../../data/icons/ui/trash.svg");
                            has-icon: true;
                            danger: true;
                            clicked => { root.request-clear-learned(); }
                        }
                        ModernButton {
                            text: "Restore Defaults...";
                            icon: @image-url("../../../data/icons/ui/refresh.svg");
                            has-icon: true;
                            primary: false;
                            clicked => { root.request-restore-defaults(); }
                        }
                    }
                }
            }
        }
    }
}

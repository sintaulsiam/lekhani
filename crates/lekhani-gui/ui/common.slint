    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.has-hover ? #89b4fa28 : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa55 : transparent;
    animate background, border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;

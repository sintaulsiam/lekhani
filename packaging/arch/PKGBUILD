# Maintainer: Sintaul Mahdi Siam (Syntenieum) <sintaulsiam@gmail.com>
# Special thanks to Avro Keyboard (OmicronLab) & OpenBangla Keyboard
pkgbase=lekhani
pkgname=('lekhani-common' 'ibus-lekhani' 'fcitx5-lekhani' 'lekhani')
pkgver=1.0.0
pkgrel=1
pkgdesc="Modern pure Rust Bengali input method framework and desktop suite"
arch=('x86_64' 'aarch64')
url="https://github.com/sintaulsiam/lekhani"
license=('GPL-3.0-or-later')
makedepends=('cargo' 'rust' 'cmake' 'extra-cmake-modules' 'fcitx5')
source=("$pkgbase-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgbase-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgbase-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --workspace
    if [ -d "/usr/include/Fcitx5" ] || pkg-config --exists Fcitx5Core 2>/dev/null || pkg-config --exists fcitx5 2>/dev/null; then
        cmake -B crates/lekhani-fcitx5/build -S crates/lekhani-fcitx5 -DCMAKE_BUILD_TYPE=Release
        cmake --build crates/lekhani-fcitx5/build --config Release
    fi
}

check() {
    cd "$pkgbase-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --workspace
}

package_lekhani-common() {
    pkgdesc="Shared data, layouts, GUI, and CLI for Lekhani"
    depends=('hicolor-icon-theme')
    optdepends=('font-noto: for Bengali font rendering'
                'noto-fonts-extra: additional Bengali glyphs')

    cd "$pkgbase-$pkgver"

    # Binaries
    install -Dm755 target/release/lekhani-gui "$pkgdir/usr/bin/lekhani-gui"
    install -Dm755 target/release/lekhani "$pkgdir/usr/bin/lekhani"

    # Layouts & Dictionaries
    install -d "$pkgdir/usr/share/lekhani/layouts"
    install -Dm644 data/layouts/*.json "$pkgdir/usr/share/lekhani/layouts/"
    
    install -d "$pkgdir/usr/share/lekhani/data"
    install -Dm644 data/dictionaries/*.json "$pkgdir/usr/share/lekhani/data/"

    # Icons
    install -d "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    install -Dm644 data/icons/lekhani.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lekhani.svg"
    for size in 16 22 24 32 48 64 128 256 512 1024; do
        if [ -f "data/icons/${size}.png" ]; then
            install -Dm644 "data/icons/${size}.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/lekhani.png"
        fi
    done
    install -d "$pkgdir/usr/share/lekhani/icons"
    install -Dm644 data/icons/128.png "$pkgdir/usr/share/lekhani/icons/lekhani.png"

    # Desktop Entry, AppStream Metadata & Systemd User Service
    install -Dm644 data/io.github.lekhani.keyboard.desktop "$pkgdir/usr/share/applications/io.github.lekhani.keyboard.desktop"
    install -Dm644 data/io.github.lekhani.keyboard.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.lekhani.keyboard.metainfo.xml"
    if [ -f data/systemd/lekhani-gui.service ]; then
        install -Dm644 data/systemd/lekhani-gui.service "$pkgdir/usr/lib/systemd/user/lekhani-gui.service"
    fi
}

package_ibus-lekhani() {
    pkgdesc="IBus engine for Lekhani (Bengali input method for GNOME / IBus)"
    depends=("lekhani-common=$pkgver" 'ibus')

    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/ibus-lekhani "$pkgdir/usr/bin/ibus-lekhani"
    install -Dm644 data/ibus/lekhani.xml "$pkgdir/usr/share/ibus/component/lekhani.xml"
    if [ -f data/systemd/ibus-lekhani.service ]; then
        install -Dm644 data/systemd/ibus-lekhani.service "$pkgdir/usr/lib/systemd/user/ibus-lekhani.service"
    fi
}

package_fcitx5-lekhani() {
    pkgdesc="Fcitx5 engine for Lekhani (Bengali input method for KDE Plasma 6 / Wayland)"
    depends=("lekhani-common=$pkgver" 'fcitx5')

    cd "$pkgbase-$pkgver"
    install -Dm755 crates/lekhani-fcitx5/build/fcitx5-lekhani.so "$pkgdir/usr/lib/fcitx5/fcitx5-lekhani.so"
    install -d "$pkgdir/usr/share/fcitx5/addon" "$pkgdir/usr/share/fcitx5/inputmethod"
    install -Dm644 data/fcitx5/addon/lekhani.conf "$pkgdir/usr/share/fcitx5/addon/lekhani.conf"
    install -Dm644 data/fcitx5/inputmethod/lekhani.conf "$pkgdir/usr/share/fcitx5/inputmethod/lekhani.conf"
}

package_lekhani() {
    pkgdesc="Meta-package installing Lekhani with both IBus and Fcitx5 engines"
    depends=("lekhani-common=$pkgver")
    optdepends=('ibus-lekhani: IBus engine for GNOME'
                'fcitx5-lekhani: Fcitx5 engine for KDE Plasma 6 and Wayland')
}

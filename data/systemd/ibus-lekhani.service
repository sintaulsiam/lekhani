[Unit]
Description=Lekhani IBus Input Method Engine
Documentation=https://github.com/sintaulsiam/lekhani
PartOf=graphical-session.target
After=ibus.service graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ibus-lekhani --ibus
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
